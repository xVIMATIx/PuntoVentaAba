@page "/inventario/respaldos"
@inject RespaldoService ServicioRespaldos
@inject ILoggerFactory Logs
<PageTitle>Respaldos - PuntoAba</PageTitle>
<div class="inv-page"><div class="page-header"><div><h2 class="page-title">Respaldos y recuperación</h2><p>Conserva una copia de la base de datos y las imágenes de productos.</p></div><button type="button" class="btn btn-primary" disabled="@ocupado" @onclick="Crear">@(ocupado?"Procesando…":"Crear respaldo ahora")</button></div>
<div class="module-summary"><div><span>Respaldos disponibles</span><strong>@archivos.Count</strong></div><div><span>Respaldo más reciente</span><strong style="font-size:17px">@(archivos.OrderByDescending(r=>r.Fecha).FirstOrDefault()?.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")??"Sin registros")</strong></div><div><span>Copias automáticas</span><strong style="font-size:17px">@(ServicioRespaldos.Automaticos?"Cada 24 horas":"Desactivadas")</strong></div></div>
<div class="module-note">Las copias automáticas se crean mientras ABA está abierto. Guarda una copia adicional en otro medio para protegerte si falla la computadora.<details><summary>Ver carpeta de respaldos</summary><p style="overflow-wrap:anywhere">@ServicioRespaldos.Carpeta</p></details></div>
@if(error!=""){<div class="alert alert-danger" role="alert">@error</div>}@if(exito!=""){<div class="alert alert-success" role="status">@exito</div>}
<div class="card"><div class="card-header"><span>Archivos disponibles</span><button type="button" class="btn btn-outline-secondary" disabled="@ocupado" @onclick="Actualizar">Actualizar lista</button></div><div class="table-responsive"><table class="table"><thead><tr><th>Archivo</th><th>Fecha</th><th>Tamaño</th><th>Comprobación</th></tr></thead><tbody>@foreach(var r in archivos.OrderByDescending(r=>r.Fecha)){<tr><td>@r.Nombre</td><td>@r.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@((r.Bytes/1024d/1024d).ToString("N2")) MB</td><td><button type="button" class="btn btn-outline-primary" disabled="@ocupado" @onclick="()=>Verificar(r.Nombre)">Comprobar recuperación</button></td></tr>}@if(archivos.Count==0){<tr><td colspan="4" class="module-empty">@(ocupado?"Consultando respaldos…":"Aún no hay respaldos disponibles. Crea el primero con el botón superior.")</td></tr>}</tbody></table></div></div><p class="inv-description">Comprobar recuperación abre una copia temporal y verifica su integridad. Esta acción no reemplaza la base de trabajo.</p></div>
@code{
    private List<ArchivoRespaldo> archivos=new();private string error="",exito="";private bool ocupado;
    protected override async Task OnInitializedAsync()=>await Actualizar();
    private async Task Actualizar(){if(ocupado)return;ocupado=true;error="";try{archivos=await ServicioRespaldos.ListarAsync();}catch(Exception ex){Error(ex);}finally{ocupado=false;}}
    private async Task Crear(){if(ocupado)return;ocupado=true;error=exito="";try{var nombre=await ServicioRespaldos.CrearAsync();exito="Respaldo creado: "+nombre;try{archivos=await ServicioRespaldos.ListarAsync();}catch{exito+=" Actualiza la lista para consultarlo.";}}catch(Exception ex){Error(ex);}finally{ocupado=false;}}
    private async Task Verificar(string nombre){if(ocupado)return;ocupado=true;error=exito="";try{var r=await ServicioRespaldos.VerificarAsync(nombre);exito=$"Recuperación comprobada: {r.Productos} productos, {r.Ventas} ventas, {r.Movimientos} movimientos y {r.Imagenes} imágenes. La base de trabajo no se reemplazó.";}catch(Exception ex){Error(ex);}finally{ocupado=false;}}
    private void Error(Exception ex){Logs.CreateLogger("Respaldos").LogError(ex,"Error de respaldo");error=ex is ArgumentException or UnauthorizedAccessException or InvalidOperationException?ex.Message:"No se pudo completar el respaldo. Revisa espacio y permisos de la carpeta.";}
}
