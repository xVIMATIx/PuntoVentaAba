@page "/inventario/movimientos"
@inject IInventarioService InventarioService
@inject IControlInventarioService Control
@inject ILoggerFactory LoggerFactory
<PageTitle>Movimientos de inventario - PuntoAba</PageTitle>
<div class="inv-page"><div class="page-header"><div><h2 class="page-title">Movimientos y correcciones</h2><p>Consulta cada cambio de existencias y conserva su trazabilidad.</p></div><a href="inventario/entradas" class="btn btn-outline-primary">Recibir mercancía</a></div>
<form class="module-toolbar" @onsubmit="Buscar" @onsubmit:preventDefault="true"><div><label for="mov-desde">Desde</label><input id="mov-desde" type="date" class="form-control" @bind="filtro.Desde" disabled="@cargando" /></div><div><label for="mov-hasta">Hasta</label><input id="mov-hasta" type="date" class="form-control" @bind="filtro.Hasta" disabled="@cargando" /></div><div><label for="mov-tipo">Tipo</label><select id="mov-tipo" class="form-select" @bind="filtro.Tipo" disabled="@cargando"><option value="">Todos</option><option>Entrada</option><option>Salida</option><option>Ajuste</option><option>Merma</option><option value="DevolucionCliente">Devolución vendible</option><option value="DevolucionNoVendible">Devolución no vendible</option><option value="DevolucionProveedor">Devolución a proveedor</option><option value="Correccion">Corrección</option></select></div><div><label for="mov-buscar">Producto, código o referencia</label><input id="mov-buscar" type="search" class="form-control" @bind="filtro.Buscar" @bind:event="oninput" disabled="@cargando" /></div><button type="submit" class="btn btn-primary" disabled="@cargando">Buscar</button><button type="button" class="btn btn-outline-secondary" @onclick="Limpiar" disabled="@cargando">Limpiar</button></form>
@if(error!=""){<div class="alert alert-danger" role="alert">@error</div>}@if(exito!=""){<div class="alert alert-success" role="status">@exito</div>}
<div class="card"><div class="card-header"><span>Movimientos registrados</span><small>@total resultados</small></div><div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cambio</th><th>Antes</th><th>Después</th><th>Motivo y referencia</th><th>Responsable</th><th></th></tr></thead><tbody>@foreach(var m in movimientos){<tr><td>@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><strong>@m.Producto</strong><small>@m.Codigo</small></td><td><span class="badge bg-info">@EtiquetasInventario.Tipo(m.Tipo)</span></td><td>@(m.Tipo=="DevolucionNoVendible"?$"{m.Cantidad:0.###} no vendible":(m.StockNuevo-m.StockAnterior).ToString("+0.###;-0.###;0"))</td><td>@m.StockAnterior.ToString("0.###")</td><td>@m.StockNuevo.ToString("0.###")</td><td>@m.Motivo<small>@m.Referencia</small>@if(m.MovimientoOriginalId.HasValue){<small>Vinculado al movimiento @m.MovimientoOriginalId</small>}</td><td>@(m.Usuario??"Sin usuario registrado")</td><td><button type="button" class="btn btn-outline-primary" disabled="@cargando" aria-label="@($"Corregir movimiento {m.Id}")" @onclick="()=>PrepararCorreccion(m)">Corregir</button></td></tr>}@if(movimientos.Count==0){<tr><td colspan="9" class="module-empty">@(cargando?"Consultando movimientos…":"No hay movimientos con estos filtros.")</td></tr>}</tbody></table></div></div>
<div class="inv-actions"><span>@total movimientos · Página @filtro.Pagina de @TotalPaginas</span><div class="inv-buttons"><button type="button" class="btn btn-outline-primary" disabled="@(cargando||filtro.Pagina<=1)" @onclick="()=>CambiarPagina(-1)">Anterior</button><button type="button" class="btn btn-outline-primary" disabled="@(cargando||filtro.Pagina>=TotalPaginas)" @onclick="()=>CambiarPagina(1)">Siguiente</button></div></div>
@if(corregir!=null){<div class="modal show d-block" role="dialog" aria-modal="true" aria-labelledby="movement-correction-title" tabindex="-1" @onkeydown="Tecla"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form @onsubmit="AplicarCorreccion" @onsubmit:preventDefault="true"><div class="modal-header"><h3 class="modal-title" id="movement-correction-title">Corregir movimiento @corregir.Id</h3><button type="button" class="btn-close" aria-label="Cerrar corrección" disabled="@cargando" @onclick="CerrarCorreccion"></button></div><div class="modal-body"><strong>@corregir.Producto</strong><p>@EtiquetasInventario.Tipo(corregir.Tipo) · @corregir.StockAnterior.ToString("0.###") → @corregir.StockNuevo.ToString("0.###")</p><div class="module-note">Se registrará el cambio inverso vinculado al movimiento original. No se borra el registro ni se modifica el cobro de una venta.</div>@if(errorCorreccion!=""){<div class="alert alert-danger" role="alert">@errorCorreccion</div>}<label for="correction-reason">Motivo obligatorio</label><textarea id="correction-reason" class="form-control" rows="2" required minlength="3" maxlength="400" disabled="@cargando" @bind="motivoCorreccion" @bind:event="oninput"></textarea></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" disabled="@cargando" @onclick="CerrarCorreccion">Cancelar</button><button type="submit" class="btn btn-primary" disabled="@cargando">@(cargando?"Guardando…":"Confirmar corrección")</button></div></form></div></div></div><div class="modal-backdrop show"></div>}
</div>
@code{
    private FiltroMovimientosDto filtro=new();private List<MovimientoInventarioDto> movimientos=new();private MovimientoInventarioDto? corregir;private string motivoCorreccion="",errorCorreccion="",error="",exito="";private Guid operacionCorreccion=Guid.NewGuid();private int total;private bool cargando;
    private int TotalPaginas=>Math.Max(1,(int)Math.Ceiling(total/(double)filtro.TamanoPagina));
    protected override async Task OnInitializedAsync()=>await Cargar();
    private void PrepararCorreccion(MovimientoInventarioDto m){if(cargando)return;corregir=m;motivoCorreccion=errorCorreccion="";operacionCorreccion=Guid.NewGuid();}
    private void CerrarCorreccion(){if(!cargando)corregir=null;}
    private void Tecla(KeyboardEventArgs e){if(e.Key=="Escape")CerrarCorreccion();}
    private async Task AplicarCorreccion(){if(cargando||corregir==null)return;cargando=true;errorCorreccion="";try{var r=await Control.CorregirAsync(corregir.Id,motivoCorreccion,operacionCorreccion);exito=$"Corrección registrada como movimiento {r.Id}. Existencias: {r.StockAnterior:0.###} → {r.StockNuevo:0.###}.";corregir=null;}catch(Exception ex){errorCorreccion=ex is ArgumentException or UnauthorizedAccessException?ex.Message:"No se pudo corregir. Tu motivo se conserva; revisa las existencias antes de reintentar.";}finally{cargando=false;}if(corregir==null)await Cargar();}
    private async Task Buscar(){if(cargando)return;filtro.Pagina=1;exito="";await Cargar();}
    private async Task Limpiar(){if(cargando)return;filtro=new();exito="";await Cargar();}
    private async Task CambiarPagina(int delta){if(cargando)return;filtro.Pagina=Math.Clamp(filtro.Pagina+delta,1,TotalPaginas);await Cargar();}
    private async Task Cargar(){cargando=true;error="";try{var pagina=await InventarioService.ObtenerMovimientosAsync(filtro);movimientos=pagina.Movimientos;total=pagina.Total;}catch(Exception ex){LoggerFactory.CreateLogger("MovimientosInventario").LogError(ex,"Error al consultar movimientos");error=ex is ArgumentException?ex.Message:"No se pudieron consultar los movimientos.";movimientos=new();total=0;}finally{cargando=false;}}
}
