@page "/dashboard"
@page "/inicio"
@inject IDashboardService DashboardService
@inject SesionUsuarioService Sesion
@inject ILoggerFactory Logs

<PageTitle>Inicio · Abarrotes Agustín</PageTitle>
<div class="aba-home">
    <div class="aba-home-heading"><div><span class="aba-eyebrow">TU NEGOCIO, DE UN VISTAZO</span><p>Resumen y accesos a tus herramientas de trabajo.</p></div>
        @if (Gestion) { <button type="button" class="aba-refresh" disabled="@cargando" @onclick="Cargar"><Icono Nombre="actualizar" /><span>Actualizar</span></button> }
    </div>
    @if (error != "") { <p class="alert alert-warning" role="alert">@error</p> }
    @if (Gestion)
    {
        <section class="aba-summary" aria-label="Resumen del negocio" aria-busy="@cargando">
            <article class="aba-summary-column"><h2><Icono Nombre="venta" />Ventas</h2>
                @if (datos != null)
                {
                    <div class="aba-sale-stat"><span>Hoy</span><div><strong>@Moneda(datos.VentasHoy.Total)</strong><span class="aba-count">@datos.VentasHoy.Cantidad<small>ventas</small></span></div></div>
                    <div class="aba-sale-stat"><span>Este mes</span><div><strong>@Moneda(datos.VentasMes.Total)</strong><span class="aba-count">@datos.VentasMes.Cantidad<small>ventas</small></span></div></div>
                }
                else { <p class="aba-empty">@(cargando ? "Cargando resumen…" : "Resumen no disponible")</p> }
            </article>
            <article class="aba-summary-column"><h2><Icono Nombre="caja" />Inventario</h2>
                @if (datos != null)
                {
                    <a href="inventario?estado=agotados" class="aba-stock-stat"><span><strong>Agotados</strong><small>Sin existencias</small></span><b>@datos.Inventario.Agotados</b></a>
                    <a href="inventario?estado=bajo" class="aba-stock-stat"><span><strong>Stock bajo</strong><small>En el mínimo o por debajo</small></span><b>@datos.Inventario.StockBajoSinAgotados</b></a>
                    <div class="aba-summary-foot">@datos.Inventario.TotalProductos productos activos</div>
                }
                else { <p class="aba-empty">@(cargando ? "Cargando inventario…" : "Resumen no disponible")</p> }
            </article>
            <article class="aba-summary-column"><h2><Icono Nombre="historial" />Historial</h2>
                <div class="aba-mini-caption">Últimas ventas</div>
                <table class="aba-mini-table"><thead><tr><th>Hora</th><th>Folio</th><th>Importe</th></tr></thead><tbody>
                    @foreach (var v in datos?.VentasRecientes ?? new())
                    {
                        <tr><td><time title="@v.Fecha.ToString("dd/MM/yyyy HH:mm")">@v.Fecha.ToString("HH:mm")</time></td><td><a href="@($"ventas?ventaId={v.Id}")">@v.Folio</a></td><td>@Moneda(v.Importe)</td></tr>
                    }
                </tbody></table>
                @if (datos != null && datos.VentasRecientes.Count == 0) { <p class="aba-empty">Todavía no hay ventas registradas.</p> }
            </article>
            <article class="aba-summary-column"><h2><Icono Nombre="clientes" />Clientes</h2>
                <div class="aba-mini-caption">Mayores compras del mes</div>
                @if (datos?.ClientesFrecuentes.Count > 0)
                {
                    <ol class="aba-customer-ranking">@foreach (var c in datos.ClientesFrecuentes) { <li><a href="@($"clientes?buscar={Uri.EscapeDataString(c.Nombre)}")">@c.Nombre</a><strong>@Moneda(c.Importe)</strong></li> }</ol>
                }
                else { <p class="aba-empty">@(cargando ? "Cargando clientes…" : "Sin compras de clientes identificados este mes.")</p> }
                <div class="aba-customer-total"><span>Clientes registrados</span><strong>@(datos?.Clientes.Registrados.ToString() ?? "—")</strong></div>
            </article>
        </section>
        <p class="aba-asof">@(consultado.HasValue ? $"Actualizado: {consultado:dd/MM/yyyy HH:mm}" : "Consultando información…")</p>
    }
    else { <p class="aba-cashier-notice">Elige una herramienta para comenzar. Los resúmenes del negocio están disponibles para administración.</p> }
    <section class="aba-access-section" aria-labelledby="aba-access-title">
        <div class="aba-section-heading"><h2 id="aba-access-title">Herramientas de trabajo</h2><span>Toca una pantalla para abrirla</span></div>
        <div class="aba-access-grid">
            @foreach (var grupo in grupos)
            {
                <div class="aba-access-column"><h3>@grupo</h3>
                    @foreach (var acceso in MenuAplicacion.Pantallas.Where(p => p.Grupo == grupo && MenuAplicacion.PuedeAbrir(p.Ruta, Sesion.UsuarioActual?.Rol)))
                    {
                        <a class="aba-screen-button" href="@acceso.Ruta"><Icono Nombre="@acceso.Icono" /><span>@acceso.Titulo</span><span class="aba-access-arrow" aria-hidden="true">›</span></a>
                    }
                    @if (!MenuAplicacion.Pantallas.Any(p => p.Grupo == grupo && MenuAplicacion.PuedeAbrir(p.Ruta, Sesion.UsuarioActual?.Rol))) { <p class="aba-empty">Acceso restringido para este usuario.</p> }
                </div>
            }
        </div>
    </section>
</div>
@code {
    private readonly string[] grupos = { "Ventas", "Inventario", "Historial", "Clientes" };
    private bool Gestion => Sesion.UsuarioActual?.Rol is "Admin" or "Supervisor";
    private EstadisticasDashboard? datos;
    private bool cargando;
    private string error = "";
    private DateTime? consultado;
    protected override async Task OnInitializedAsync() { if (Gestion) await Cargar(); }
    private static string Moneda(decimal n) => "$" + n.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("es-MX"));
    private async Task Cargar()
    {
        if (cargando) return;
        cargando = true; error = "";
        try { datos = await DashboardService.ObtenerEstadisticasAsync(); consultado = DateTime.Now; }
        catch (Exception ex) { Logs.CreateLogger("Inicio").LogError(ex, "Error al consultar Inicio"); error = "No se pudo actualizar el resumen. Puedes seguir usando los accesos o intentar de nuevo."; }
        finally { cargando = false; }
    }
}
