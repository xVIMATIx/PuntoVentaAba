@page "/reportes"
@inject IVentaService VentaService
<PageTitle>Reportes de ventas - PuntoAba</PageTitle>
<div class="page-header"><div><h2 class="page-title">Reportes de ventas</h2><p>Consulta los importes y las operaciones del periodo elegido.</p></div></div>
<form class="module-toolbar" @onsubmit="GenerarReporte" @onsubmit:preventDefault="true"><div><label for="sales-from">Desde</label><input id="sales-from" type="date" class="form-control" @bind="fechaInicio" disabled="@ocupado" /></div><div><label for="sales-to">Hasta</label><input id="sales-to" type="date" class="form-control" @bind="fechaFin" disabled="@ocupado" /></div><button type="submit" class="btn btn-primary" disabled="@ocupado">@(ocupado?"Consultando…":"Consultar reporte")</button><button type="button" class="btn btn-outline-secondary" disabled="@ocupado" @onclick="Hoy">Hoy</button><button type="button" class="btn btn-outline-secondary" disabled="@ocupado" @onclick="Mes">Este mes</button></form>
@if(error!=""){<div class="alert alert-danger" role="alert">@error</div>}
@if(reporte!=null){
<div class="module-summary"><div><span>Importe de ventas</span><strong>$@reporte.TotalVentas.ToString("N2")</strong></div><div><span>Ventas registradas</span><strong>@reporte.CantidadVentas</strong></div><div><span>Importe promedio</span><strong>$@reporte.PromedioVenta.ToString("N2")</strong></div><div><span>Periodo consultado</span><strong style="font-size:16px">@reporte.FechaInicio.ToString("dd/MM/yyyy")<br />@reporte.FechaFin.ToString("dd/MM/yyyy")</strong></div></div>
<div class="card"><div class="card-header"><span>Detalle de ventas</span><small>Abre el recibo para consultar productos y cobro</small></div><div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Folio</th><th>Cliente</th><th>Total</th><th>Método</th><th></th></tr></thead><tbody>@foreach(var v in reporte.Ventas){<tr><td>@v.FechaVenta.ToString("dd/MM/yyyy HH:mm")</td><td><strong>@v.NumeroVenta</strong></td><td>@v.ClienteNombre</td><td>$@v.Total.ToString("N2")</td><td><span class="badge bg-info">@v.MetodoPago</span></td><td><a class="btn btn-outline-primary" href="@($"ventas?ventaId={v.Id}")">Ver recibo</a></td></tr>}@if(reporte.Ventas.Count==0){<tr><td colspan="6" class="module-empty">No hay ventas registradas en este periodo.</td></tr>}</tbody></table></div></div>
}
@code{
    private DateTime fechaInicio=DateTime.Today.AddMonths(-1),fechaFin=DateTime.Today;private ReporteVentasDto? reporte;private string error="";private bool ocupado;
    protected override async Task OnInitializedAsync()=>await GenerarReporte();
    private Task Hoy(){fechaInicio=fechaFin=DateTime.Today;return GenerarReporte();}
    private Task Mes(){fechaInicio=new DateTime(DateTime.Today.Year,DateTime.Today.Month,1);fechaFin=DateTime.Today;return GenerarReporte();}
    private async Task GenerarReporte(){if(ocupado)return;error="";if(fechaInicio.Date>fechaFin.Date){error="La fecha inicial debe ser anterior o igual a la fecha final.";return;}ocupado=true;try{reporte=await VentaService.ObtenerReporteAsync(fechaInicio,fechaFin);}catch{reporte=null;error="No se pudo consultar el reporte. Inténtalo de nuevo.";}finally{ocupado=false;}}
}
