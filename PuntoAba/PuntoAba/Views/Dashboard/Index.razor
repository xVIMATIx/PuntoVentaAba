@page "/dashboard"
@using System.Net.Http.Json
@inject HttpClient Http
@inject SesionUsuarioService SesionUsuario
@inject NavigationManager Navigation

<PageTitle>Dashboard - PuntoAba</PageTitle>

<div class="dashboard">
    <h1 class="page-title">📊 Dashboard</h1>

    @if (loading)
    {
        <div class="loading-spinner">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else if (estadisticas != null)
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="text-muted">
                Sesión: <strong>@SesionUsuario.UsuarioActual?.NombreCompleto</strong> (@SesionUsuario.UsuarioActual?.Rol)
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RecargarEstadisticas">Actualizar</button>
                <button class="btn btn-outline-danger btn-sm" @onclick="CerrarSesion">Cerrar sesión</button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(mensajeError))
        {
            <div class="alert alert-warning">@mensajeError</div>
        }

        <div class="stats-grid">
            <div class="stat-card stat-primary">
                <div class="stat-icon">💰</div>
                <div class="stat-content">
                    <h3>Ventas Hoy</h3>
                    <div class="stat-value">$@estadisticas.VentasHoy.Total.ToString("N2")</div>
                    <div class="stat-detail">@estadisticas.VentasHoy.Cantidad ventas</div>
                </div>
            </div>

            <div class="stat-card stat-success">
                <div class="stat-icon">📅</div>
                <div class="stat-content">
                    <h3>Ventas del Mes</h3>
                    <div class="stat-value">$@estadisticas.VentasMes.Total.ToString("N2")</div>
                    <div class="stat-detail">@estadisticas.VentasMes.Cantidad ventas</div>
                </div>
            </div>

            <div class="stat-card stat-info">
                <div class="stat-icon">📦</div>
                <div class="stat-content">
                    <h3>Productos</h3>
                    <div class="stat-value">@estadisticas.Inventario.TotalProductos</div>
                    <div class="stat-detail">@estadisticas.Inventario.ProductosStockBajo con stock bajo</div>
                </div>
            </div>

            <div class="stat-card stat-warning">
                <div class="stat-icon">👥</div>
                <div class="stat-content">
                    <h3>Clientes</h3>
                    <div class="stat-value">@estadisticas.Clientes.Total</div>
                    <div class="stat-detail">@estadisticas.Clientes.NuevosEsteMes nuevos este mes</div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>🏆 Productos Más Vendidos</h5>
                    </div>
                    <div class="card-body">
                        @if (estadisticas.ProductosTop.Any())
                        {
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">Total</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var producto in estadisticas.ProductosTop)
                                    {
                                        <tr>
                                            <td>@producto.Nombre</td>
                                            <td class="text-end">@FormatearCantidad(producto.CantidadVendida)</td>
                                            <td class="text-end">$@producto.TotalVentas.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <p class="text-muted">No hay datos de ventas este mes</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header">
                        <h5>⚡ Acciones Rápidas</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-grid gap-2">
                            <a href="/ventas/nuevo" class="btn btn-primary btn-lg">
                                🛒 Nueva Venta
                            </a>
                            <a href="/productos" class="btn btn-outline-primary">
                                📦 Gestionar Productos
                            </a>
                            <a href="/clientes" class="btn btn-outline-primary">
                                👥 Gestionar Clientes
                            </a>
                            <a href="/reportes" class="btn btn-outline-secondary">
                                📊 Ver Reportes
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="text-muted">
                Sesión: <strong>@SesionUsuario.UsuarioActual?.NombreCompleto</strong> (@SesionUsuario.UsuarioActual?.Rol)
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="RecargarEstadisticas">Reintentar</button>
                <button class="btn btn-outline-danger btn-sm" @onclick="CerrarSesion">Cerrar sesión</button>
            </div>
        </div>

        <div class="alert alert-warning">
            @(mensajeError ?? "No se pudieron cargar los datos del dashboard.")
        </div>
    }
</div>

@code {
    private bool loading = true;
    private EstadisticasDashboard? estadisticas;
    private string? mensajeError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await SesionUsuario.CargarSesionGuardadaAsync();
        if (!SesionUsuario.EstaAutenticado)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await CargarEstadisticas();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CargarEstadisticas()
    {
        loading = true;
        mensajeError = null;

        try
        {
            var response = await Http.GetAsync("api/dashboard/estadisticas");

            if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
            {
                mensajeError = "Tu sesión expiró. Vuelve a iniciar sesión.";
                await CerrarSesion();
                return;
            }

            if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                mensajeError = "Tu usuario no tiene permisos para ver el dashboard (requiere rol Admin o Supervisor).";
                estadisticas = null;
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                mensajeError = $"No se pudieron cargar estadísticas ({(int)response.StatusCode}).";
                estadisticas = null;
                return;
            }

            var respuesta = await response.Content.ReadFromJsonAsync<EstadisticasDashboard>();
            if (respuesta == null)
            {
                mensajeError = "La API devolvió una respuesta inválida para el dashboard.";
                estadisticas = null;
                return;
            }

            estadisticas = respuesta;
        }
        catch (HttpRequestException ex)
        {
            mensajeError = $"Error de conexión al cargar dashboard: {ex.Message}";
            estadisticas = null;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CerrarSesion()
    {
        await SesionUsuario.CerrarSesionAsync();
        estadisticas = null;
        loading = false;
        Navigation.NavigateTo("/login");
    }

    private async Task RecargarEstadisticas()
    {
        await CargarEstadisticas();
    }

    private static string FormatearCantidad(decimal cantidad)
    {
        return decimal.Truncate(cantidad) == cantidad
            ? cantidad.ToString("N0")
            : cantidad.ToString("N3");
    }

    public class EstadisticasDashboard
    {
        public VentasStat VentasHoy { get; set; } = new();
        public VentasStat VentasMes { get; set; } = new();
        public InventarioStat Inventario { get; set; } = new();
        public ClientesStat Clientes { get; set; } = new();
        public List<ProductoTop> ProductosTop { get; set; } = new();
    }

    public class VentasStat
    {
        public decimal Total { get; set; }
        public int Cantidad { get; set; }
    }

    public class InventarioStat
    {
        public int TotalProductos { get; set; }
        public int ProductosStockBajo { get; set; }
        public decimal ValorInventario { get; set; }
    }

    public class ClientesStat
    {
        public int Total { get; set; }
        public int NuevosEsteMes { get; set; }
    }

    public class ProductoTop
    {
        public int ProductoId { get; set; }
        public string Nombre { get; set; } = "";
        public decimal CantidadVendida { get; set; }
        public decimal TotalVentas { get; set; }
    }
}
