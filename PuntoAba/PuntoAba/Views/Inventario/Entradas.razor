@page "/inventario/entradas"
<PageTitle>Entradas de mercancía - Abarrotes Agustín</PageTitle>
<div class="inv-page entries-page">
    <div class="page-header"><div><h2 class="page-title">Entradas de mercancía</h2><p class="inv-description">Agrega lo que llegó, revisa las cantidades y confirma la recepción.</p></div><a class="btn btn-outline-primary" href="inventario/movimientos">Ver movimientos</a></div>
    <div class="entry-tabs" role="group" aria-label="Vista de entradas"><button type="button" class="@(!verHistorial ? "is-active" : "")" aria-pressed="@(!verHistorial ? "true" : "false")" disabled="@Bloqueado" @onclick="() => CambiarVista(false)">Nueva recepción <small>@entrada.Detalles.Count</small></button><button type="button" class="@(verHistorial ? "is-active" : "")" aria-pressed="@(verHistorial ? "true" : "false")" disabled="@Bloqueado" @onclick="() => CambiarVista(true)">Recepciones anteriores <small>@entradas.Count</small></button></div>
    <div class="entry-scroll">
        @if (exito != "") { <div class="alert alert-success" role="status">@exito</div> }
        @if (error != "" && !mostrarRevision) { <div class="alert alert-danger" role="alert">@error</div> }
        @if (cargando) { <div class="inv-empty" role="status">Cargando productos y recepciones…</div> }
        else if (verHistorial)
        {
            <div class="card"><div class="card-header"><span>Recepciones anteriores</span><small>Últimas 50 entradas</small></div>
            @if (entradas.Count == 0) { <div class="inv-empty">Todavía no hay recepciones registradas.</div> }
            else { <div class="table-responsive"><table class="table"><thead><tr><th>Folio</th><th>Fecha</th><th>Proveedor</th><th>Documento</th><th>Total</th><th></th></tr></thead><tbody>@foreach (var e in entradas) { <tr><td>@e.Folio</td><td>@e.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@(string.IsNullOrWhiteSpace(e.Proveedor) ? "Sin proveedor" : e.Proveedor)</td><td>@e.Documento</td><td>$@e.Total.ToString("N2")</td><td><button type="button" class="btn btn-outline-primary" @onclick="() => detalleId = detalleId == e.Id ? null : e.Id">@(detalleId == e.Id ? "Cerrar detalle" : "Ver detalle")</button></td></tr>@if (detalleId == e.Id) { <tr><td colspan="6"><ul class="inv-detail">@foreach (var d in e.Detalles) { <li>@d.Nombre · @d.Codigo: @d.CantidadBase.ToString("0.###") @d.UnidadMedida × $@d.CostoUnitario.ToString("N2") = $@d.Importe.ToString("N2")</li> }</ul>@if (!string.IsNullOrWhiteSpace(e.Notas)) { <p>@e.Notas</p> }</td></tr> } }</tbody></table></div> }</div>
        }
        else
        {
            <section class="entry-search-card" aria-label="Agregar productos a la recepción"><form class="entry-search" @onsubmit="EnviarBusqueda" @onsubmit:preventDefault="true"><Icono Nombre="buscar" /><input id="entry-search" @ref="campoBusqueda" data-touch-enter type="search" class="form-control" aria-label="Buscar o escanear producto" placeholder="Escanea un código o busca por nombre" autocomplete="off" spellcheck="false" @bind="busqueda" @bind:event="oninput" disabled="@Bloqueado" /><button type="submit" class="btn btn-outline-primary" disabled="@Bloqueado">Agregar</button></form>
            @if (!string.IsNullOrWhiteSpace(busqueda)) { <div class="entry-results" aria-label="Resultados de búsqueda">@foreach (var p in Coincidencias) { <button type="button" disabled="@Bloqueado" @onclick="() => Agregar(p)"><span><strong>@p.Nombre</strong><small>@p.Codigo · @p.UnidadMedida</small></span><span>Agregar <Icono Nombre="derecha" /></span></button> }@if (!Coincidencias.Any()) { <p>No hay coincidencias. Si es un producto nuevo, regístralo primero en Productos.</p> }</div> }</section>
            <EditForm Model="entrada" @key="entrada" @ref="formulario" OnSubmit="IgnorarEnvio"><DataAnnotationsValidator /><ValidationSummary /><fieldset class="inv-fieldset" disabled="@Bloqueado">
                @if (entrada.Detalles.Count == 0) { <div class="card inv-empty"><strong>¿Qué mercancía llegó?</strong><p>Escanea un producto o búscalo por nombre para empezar.</p><a href="inventario/resurtido">También puedes preparar la lista desde Resurtido.</a></div> }
                @foreach (var l in entrada.Detalles)
                {
                    <article class="entry-line" @key="l.ProductoId"><div class="entry-line-heading"><div><strong>@l.Nombre</strong><small>@l.Codigo · @l.UnidadMedida</small></div><button type="button" class="btn btn-outline-danger" aria-label="@($"Quitar {l.Nombre}")" @onclick="() => entrada.Detalles.Remove(l)">Quitar</button></div>
                    <div class="entry-line-grid"><div><label for="@($"entry-qty-{l.ProductoId}")">¿Cuánto llegó?</label><InputNumber id="@($"entry-qty-{l.ProductoId}")" class="form-control" aria-label="@($"Cantidad recibida de {l.Nombre}")" @bind-Value="l.Cantidad" min="@(l.EsPorPeso ? "0.001" : "1")" step="@(l.EsPorPeso ? "0.001" : "1")" inputmode="decimal" />
                    @if (!l.EsPorPeso) { <div class="entry-unit-mode"><label><InputCheckbox @bind-Value="l.PorCaja" /> Recibir por cajas</label></div>@if (l.PorCaja) { <label for="@($"entry-box-{l.ProductoId}")">Piezas por caja</label><InputNumber id="@($"entry-box-{l.ProductoId}")" class="form-control" aria-label="@($"Piezas por caja de {l.Nombre}")" @bind-Value="l.PiezasPorCaja" min="1" max="100000" step="1" /><p class="entry-conversion">@l.Cantidad.ToString("0.###") cajas × @l.PiezasPorCaja piezas = <strong>@l.CantidadBase.ToString("0.###") piezas</strong></p> } else { <small>Piezas recibidas</small> } } else { <small>Cantidad en @l.UnidadMedida</small> }</div>
                    <div><label for="@($"entry-cost-{l.ProductoId}")">@(l.EsPorPeso ? $"Costo por {l.UnidadMedida}" : "Costo por pieza")</label><div class="entry-money"><span>$</span><InputNumber id="@($"entry-cost-{l.ProductoId}")" class="form-control" aria-label="@($"Costo unitario de {l.Nombre}")" @bind-Value="l.CostoUnitario" min="0" step="0.01" inputmode="decimal" /></div>@if (l.PorCaja) { <small>Es el costo de una pieza, no el de la caja.</small> }<div class="entry-line-total"><span>Importe</span><strong>$@l.Importe.ToString("N2")</strong></div></div>
                    <div class="entry-stock"><span>Existencias</span><div>Había <strong>@Numero(l.StockEsperado)</strong></div><Icono Nombre="derecha" /><div>Quedarán <strong>@Numero(l.StockResultante)</strong></div><small>Se sumarán @l.CantidadBase.ToString("0.###") @l.UnidadMedida al confirmar.</small></div></div></article>
                }
                <button type="button" class="entry-options-toggle" aria-expanded="@(mostrarDatos ? "true" : "false")" aria-controls="entry-optional" @onclick="() => mostrarDatos = !mostrarDatos"><span><strong>Datos de la recepción</strong><small>Proveedor, factura o nota y comentarios · Opcionales</small></span><Icono Nombre="@(mostrarDatos ? "arriba" : "derecha")" /></button>
                <div id="entry-optional" class="entry-optional" hidden="@(!mostrarDatos)"><div class="inv-fields"><div><label for="entry-supplier">Proveedor</label><InputText id="entry-supplier" class="form-control" @bind-Value="entrada.Proveedor" maxlength="200" /></div><div><label for="entry-document">Factura o nota</label><InputText id="entry-document" class="form-control" @bind-Value="entrada.Documento" maxlength="100" /></div></div><label for="entry-notes">Comentarios</label><InputTextArea id="entry-notes" class="form-control" @bind-Value="entrada.Notas" rows="2" maxlength="500" /></div>
                <label class="inv-check entry-update-price"><InputCheckbox @bind-Value="entrada.ActualizarPrecioCompra" /><span>Usar estos costos como precios de compra del catálogo<small>No cambia los precios de venta.</small></span></label>
            </fieldset></EditForm>
        }
    </div>
    @if (!verHistorial) { <div class="entry-action-bar"><div><small>@entrada.Detalles.Count @(entrada.Detalles.Count == 1 ? "producto" : "productos") · Total de la recepción</small><strong>$@Total.ToString("N2")</strong></div><div><button type="button" class="btn btn-outline-primary" disabled="@(Bloqueado || cargando)" @onclick="ActualizarExistencias">Volver a consultar existencias</button><button type="button" class="btn btn-primary" disabled="@(Bloqueado || cargando || entrada.Detalles.Count == 0)" @onclick="Revisar">Revisar recepción</button></div></div> }
</div>
@if (mostrarRevision)
{
    <div class="modal show d-block entry-review" role="dialog" aria-modal="true" aria-labelledby="entry-review-title" tabindex="-1" @ref="panelRevision" @onkeydown="TeclaRevision"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h3 id="entry-review-title" class="modal-title">Revisar recepción</h3><button type="button" class="btn-close" aria-label="Cerrar revisión" disabled="@guardando" @onclick="CerrarRevision"></button></div><div class="modal-body">
        @if (error != "") { <div class="alert alert-danger" role="alert">@error</div> }
        <p class="entry-review-help">Al confirmar se sumarán estas cantidades al inventario.</p><div class="entry-review-list">@foreach (var l in entrada.Detalles) { <div><span><strong>@l.Nombre</strong><small>@l.CantidadBase.ToString("0.###") @l.UnidadMedida · Costo unitario $@l.CostoUnitario.ToString("N2")</small><small>Había @Numero(l.StockEsperado) → Quedarán @Numero(l.StockResultante)</small></span><strong>$@l.Importe.ToString("N2")</strong></div> }</div><p class="entry-review-meta">Proveedor: @(string.IsNullOrWhiteSpace(entrada.Proveedor) ? "Sin proveedor" : entrada.Proveedor)<br/>Actualizar precios de compra: @(entrada.ActualizarPrecioCompra ? "Sí" : "No")</p><div class="entry-review-total"><span>Total</span><strong>$@Total.ToString("N2")</strong></div>
    </div><div class="modal-footer"><button type="button" class="btn btn-secondary" disabled="@guardando" @onclick="CerrarRevision">Volver a editar</button><button type="button" class="btn btn-primary" disabled="@guardando" @onclick="Guardar">@(guardando ? "Registrando…" : "Confirmar recepción")</button></div></div></div></div><div class="modal-backdrop show"></div>
}
