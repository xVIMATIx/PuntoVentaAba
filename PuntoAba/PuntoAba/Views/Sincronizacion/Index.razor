@page "/sincronizacion"
@inject ISincronizacionService SincronizacionService
@inject IJSRuntime JS

<PageTitle>Sincronización - PuntoAba</PageTitle>

<h1 class="page-title">🔄 Sincronización</h1>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <h5>📊 Estado de Sincronización</h5>
            </div>
            <div class="card-body">
                @if (estado != null)
                {
                    <div class="mb-3">
                        <strong>Última Sincronización:</strong><br />
                        @(estado.UltimaSincronizacion?.ToString("dd/MM/yyyy HH:mm:ss") ?? "Nunca")
                    </div>
                    <div class="mb-3">
                        <strong>Registros Pendientes:</strong> @estado.RegistrosPendientes
                    </div>
                    <div class="mb-3">
                        <strong>Estado:</strong>
                        <span class="badge @(estado.HayCambiosPendientes ? "bg-warning" : "bg-success")">
                            @(estado.HayCambiosPendientes ? "⚠️ Pendiente" : "✅ Sincronizado")
                        </span>
                    </div>
                }

                <button class="btn btn-primary w-100" @onclick="Sincronizar" disabled="@sincronizando">
                    @if (sincronizando)
                    {
                        <span class="spinner-border spinner-border-sm me-2"></span>
                    }
                    🔄 Sincronizar Ahora
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5>📝 Historial</h5>
            </div>
            <div class="card-body">
                @if (ultimaSincronizacion != null)
                {
                    <div class="alert @(ultimaSincronizacion.Exitoso ? "alert-success" : "alert-danger")">
                        <strong>Última sincronización:</strong><br />
                        Fecha: @ultimaSincronizacion.FechaSincronizacion.ToString("dd/MM/yyyy HH:mm:ss")<br />
                        Productos: @ultimaSincronizacion.ProductosSincronizados<br />
                        Ventas: @ultimaSincronizacion.VentasSincronizadas<br />
                        Clientes: @ultimaSincronizacion.ClientesSincronizados<br />
                        Estado: @(ultimaSincronizacion.Exitoso ? "✅ Exitosa" : "❌ Error")<br />
                        @if (!string.IsNullOrEmpty(ultimaSincronizacion.Mensaje))
                        {
                            <small>@ultimaSincronizacion.Mensaje</small>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">No hay sincronizaciones recientes</p>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private EstadoSincronizacionDto? estado;
    private SincronizacionResponseDto? ultimaSincronizacion;
    private bool sincronizando = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarEstado();
    }

    private async Task CargarEstado()
    {
        estado = await SincronizacionService.ObtenerEstadoSincronizacionAsync();
    }

    private async Task Sincronizar()
    {
        sincronizando = true;
        try
        {
            var datos = await SincronizacionService.ObtenerDatosParaSincronizarAsync(estado?.UltimaSincronizacion);
            datos.DispositivoOrigen = "WEB-APP";
            
            ultimaSincronizacion = await SincronizacionService.SincronizarDatosAsync(datos);
            
            await CargarEstado();
            
            await JS.InvokeVoidAsync("alert", 
                $"Sincronización {(ultimaSincronizacion.Exitoso ? "exitosa" : "fallida")}\n\n" +
                $"Productos: {ultimaSincronizacion.ProductosSincronizados}\n" +
                $"Ventas: {ultimaSincronizacion.VentasSincronizadas}\n" +
                $"Clientes: {ultimaSincronizacion.ClientesSincronizados}");
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error en sincronización: {ex.Message}");
        }
        finally
        {
            sincronizando = false;
        }
    }
}
