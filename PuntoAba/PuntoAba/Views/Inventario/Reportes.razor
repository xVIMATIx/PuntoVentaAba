@page "/inventario/reportes"
@inject IControlInventarioService Control
@inject ILoggerFactory Logs
<PageTitle>Reportes de inventario - PuntoAba</PageTitle>
<div class="inv-page"><div class="page-header"><div><h2 class="page-title">Reportes de inventario</h2><p>Consulta existencias, valor actual y movimientos del periodo.</p></div></div>
<form class="module-toolbar" @onsubmit="Cargar" @onsubmit:preventDefault="true"><div><label for="rep-desde">Desde</label><input id="rep-desde" type="date" class="form-control" @bind="desde" /></div><div><label for="rep-hasta">Hasta</label><input id="rep-hasta" type="date" class="form-control" @bind="hasta" /></div><div><label for="rep-categoria">Categoría</label><select id="rep-categoria" class="form-select" @bind="categoria"><option value="">Todas</option>@foreach(var c in reporte?.Productos.Select(p=>p.Categoria).Distinct().OrderBy(x=>x) ?? Enumerable.Empty<string>()) { <option>@c</option> }</select></div><div><label for="rep-proveedor">Proveedor habitual</label><select id="rep-proveedor" class="form-select" @bind="proveedor"><option value="">Todos</option>@foreach(var p in reporte?.Productos.Select(p=>p.Proveedor).Where(p=>p!="").Distinct().OrderBy(x=>x) ?? Enumerable.Empty<string>()) { <option>@p</option> }</select></div><button class="btn btn-primary" disabled="@ocupado">Consultar</button></form>
@if(error!=""){<div class="alert alert-danger" role="alert">@error</div>}
@if(reporte!=null){<p class="module-note">Movimientos del @consultadoDesde.ToString("dd/MM/yyyy") al @consultadoHasta.ToString("dd/MM/yyyy"). Existencias y valor corresponden al inventario actual.</p><div class="inv-summary"><div><strong>$@Filtrados.Sum(p=>p.Valor).ToString("N2")</strong><span>Valor actual a precio de compra</span></div><div><strong>@Filtrados.Count(p=>p.Stock<=0)</strong><span>Agotados actuales</span></div><div><strong>$@reporte.CostoMermas.ToString("N2")</strong><span>Costo de mermas del periodo (todas las categorías)</span></div></div>
<div class="card"><div class="card-header">Inventario actual y rotación del periodo</div><div class="table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Existencias</th><th>Mínimo</th><th>Valor actual</th><th>Vendido</th><th>Rotación aproximada</th></tr></thead><tbody>@if(!Filtrados.Any()){<tr><td colspan="6" class="module-empty">No hay productos con estos filtros.</td></tr>}@foreach(var p in Filtrados){<tr><td>@p.Nombre<small>@p.Codigo · @p.Categoria · @p.Proveedor</small></td><td>@p.Stock.ToString("0.###")</td><td>@p.Minimo.ToString("0.###")</td><td>$@p.Valor.ToString("N2")</td><td>@p.Vendido.ToString("0.###")</td><td>@(p.Rotacion?.ToString("N2") ?? "Sin base")</td></tr>}</tbody></table></div></div>
<p class="inv-description">La rotación divide las unidades vendidas entre el promedio de existencias al inicio y al final del periodo. Es orientativa y depende de los movimientos registrados; no predice compras. El valor de inventario corresponde a las existencias actuales.</p>
<div class="card"><div class="card-header">Mermas y devoluciones del periodo</div><div class="table-responsive"><table class="table"><thead><tr><th>Fecha</th><th>Producto</th><th>Operación</th><th>Cantidad</th><th>Motivo</th><th>Responsable</th></tr></thead><tbody>@if(!reporte.MermasDevoluciones.Any()){<tr><td colspan="6" class="module-empty">No hay mermas ni devoluciones en este periodo.</td></tr>}@foreach(var m in reporte.MermasDevoluciones){<tr><td>@m.Fecha.ToLocalTime().ToString("dd/MM/yyyy")</td><td>@m.Producto</td><td>@EtiquetasInventario.Tipo(m.Tipo)</td><td>@m.Cantidad.ToString("0.###")</td><td>@m.Motivo<small>@m.Referencia</small></td><td>@m.Usuario</td></tr>}</tbody></table></div></div>@if(reporte.HayCostosEstimados){<p>Algunas mermas antiguas no guardaron costo; se estimaron con el precio de compra actual.</p>}}
</div>
@code {
    private DateTime desde=DateTime.Today.AddDays(-30), hasta=DateTime.Today, consultadoDesde, consultadoHasta; private string categoria="",proveedor="",error="";private bool ocupado;private ReporteInventarioDto? reporte;
    private IEnumerable<ProductoReporteDto> Filtrados => reporte?.Productos.Where(p=>(categoria==""||p.Categoria==categoria)&&(proveedor==""||p.Proveedor==proveedor))??Enumerable.Empty<ProductoReporteDto>();
    protected override async Task OnInitializedAsync()=>await Cargar();
    private async Task Cargar(){if(ocupado)return;ocupado=true;error="";try{var inicio=desde;var fin=hasta;reporte=await Control.ReporteAsync(inicio,fin);consultadoDesde=inicio;consultadoHasta=fin;if(categoria!=""&&!reporte.Productos.Any(p=>p.Categoria==categoria))categoria="";if(proveedor!=""&&!reporte.Productos.Any(p=>p.Proveedor==proveedor))proveedor="";}catch(Exception ex){Logs.CreateLogger("ReporteInventario").LogError(ex,"Error al consultar reporte");error=ex is ArgumentException or UnauthorizedAccessException?ex.Message:"No se pudo consultar el reporte.";}finally{ocupado=false;}}
}
