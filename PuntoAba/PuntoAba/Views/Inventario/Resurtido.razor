@page "/inventario/resurtido"
@implements IAsyncDisposable
<PageTitle>Resurtido - Abarrotes Agustín</PageTitle>
<div class="inv-page restock-page">
    <div class="restock-scroll" aria-label="Productos por resurtir">
    <div class="page-header"><div><h2 class="page-title">Resurtido</h2><p class="inv-description">Revisa qué falta, cuánto pedir y cuánto costaría.</p></div><button type="button" class="btn btn-outline-primary" disabled="@Bloqueado" @onclick="Cargar"><Icono Nombre="actualizar" />Actualizar lista</button></div>
    <div class="restock-summary"><button type="button" disabled="@Bloqueado" class="@(estado == "agotados" ? "is-active" : "")" @onclick='() => estado = estado == "agotados" ? "" : "agotados"'><span>Sin stock</span><strong>@productos.Count(p => p.Stock <= 0)</strong><small>Atender primero</small></button><button type="button" disabled="@Bloqueado" class="@(estado == "bajo" ? "is-active" : "")" @onclick='() => estado = estado == "bajo" ? "" : "bajo"'><span>Stock bajo</span><strong>@productos.Count(EsBajo)</strong><small>En el mínimo o por debajo</small></button><div><span>Costo estimado seleccionado</span><strong>$@Total.ToString("N2")</strong><small>Con el último costo de compra</small></div></div>
    <div class="restock-filters"><div class="restock-search"><Icono Nombre="buscar" /><input type="search" aria-label="Buscar en resurtido" placeholder="Buscar dentro de esta lista" autocomplete="off" @bind="busqueda" @bind:event="oninput" disabled="@Bloqueado" /></div><div class="restock-selects"><select class="form-select" aria-label="Categoría de resurtido" @bind="categoria" disabled="@Bloqueado"><option value="">Todas las categorías</option>@foreach (var c in productos.Select(p => p.Categoria).Distinct().OrderBy(x => x, Comparador)) { <option value="@c">@c</option> }</select><select class="form-select" aria-label="Proveedor de resurtido" @bind="proveedor" disabled="@Bloqueado"><option value="">Todos los proveedores</option><option value="__sin_proveedor">Sin proveedor asignado</option>@foreach (var p in productos.Select(p => p.Proveedor.Trim()).Where(p => p != "").Distinct().OrderBy(x => x, Comparador)) { <option value="@p">@p</option> }</select></div></div>
    <div class="restock-list-tools"><label><input type="checkbox" aria-label="Seleccionar productos visibles" checked="@(Filtrados.Count > 0 && Filtrados.All(p => p.Seleccionado))" disabled="@(Bloqueado || Filtrados.Count == 0)" @onchange="SeleccionarVisibles" />Seleccionar visibles</label><span>@Filtrados.Count productos · Primero sin stock</span>@if (TieneFiltros) { <button type="button" class="btn btn-outline-secondary" disabled="@Bloqueado" @onclick="LimpiarFiltros">Limpiar filtros</button> }</div>
    @if (error != "") { <div class="restock-error" role="alert">@error</div> }
        <section class="restock-manual" aria-labelledby="restock-manual-title"><div class="restock-manual-heading"><h3 id="restock-manual-title">Agregar productos</h3><p>Incluye productos del catálogo aunque tengan existencias suficientes.</p></div>
            <form class="restock-manual-search" @onsubmit="BuscarManual" @onsubmit:preventDefault="true"><Icono Nombre="buscar" /><input type="search" class="form-control" @ref="campoManual" data-touch-enter aria-label="Buscar producto para agregar al resurtido" placeholder="Escanea un código o busca por nombre" autocomplete="off" @bind="busquedaManual" @bind:event="oninput" disabled="@Bloqueado" /><button type="submit" class="btn btn-outline-primary" disabled="@Bloqueado">Agregar</button></form>
            @if(mensajeManual!="") { <p class="restock-manual-notice" role="status">@mensajeManual</p> }
            @if(!string.IsNullOrWhiteSpace(busquedaManual)) { <div class="restock-manual-results" aria-label="Productos del catálogo para agregar">@foreach(var p in CoincidenciasManuales) { <button type="button" disabled="@Bloqueado" @onclick="()=>AgregarManual(p)"><span><strong>@p.Nombre</strong><small>@p.Codigo · Existencias: @p.Stock.ToString(p.EsPorPeso ? "N3" : "N0") @p.UnidadMedida</small></span><span>@(productos.Any(r=>r.ProductoId==p.Id) ? "Seleccionar" : "Agregar")</span></button> }@if(!CoincidenciasManuales.Any()) { <p>No hay coincidencias en el catálogo activo.</p> }</div> }
        </section>
        @if (cargando) { <div class="card inv-empty" role="status">Consultando sugerencias de resurtido…</div> }
        else if (Filtrados.Count == 0) { <div class="card inv-empty"><strong>@(productos.Count == 0 ? "No hay productos en la lista" : "No hay productos con estos filtros")</strong><p>@(productos.Count == 0 ? "La lista se basa en los mínimos y objetivos registrados en Productos." : "Prueba otro nombre, categoría, proveedor o estado.")</p></div> }
        else { @foreach (var p in Filtrados)
        {
            <article class="restock-row @(p.Seleccionado ? "is-selected" : "")" @key="p.ProductoId" @onclick="() => Alternar(p)">
                <button type="button" class="restock-product" role="checkbox" aria-checked="@(p.Seleccionado ? "true" : "false")" aria-label="@($"Seleccionar {p.Nombre}")" disabled="@Bloqueado" @onclick="() => Alternar(p)" @onclick:stopPropagation="true"><span class="restock-check @(p.Seleccionado ? "is-checked" : "")" aria-hidden="true"></span><span><strong>@p.Nombre</strong><small>@p.Codigo · @p.Categoria</small><small>@NombreProveedor(p)</small><span class="restock-priority @(p.Stock <= 0 ? "is-empty" : EsBajo(p) ? "is-low" : "is-manual")">@EstadoProducto(p)</span></span></button>
                <div class="restock-stock"><div><span>Existencias</span><strong>@Cantidad(p.Stock,p) <small>@p.UnidadMedida</small></strong></div><div><span>Mínimo</span><strong>@Cantidad(p.Minimo,p) <small>@p.UnidadMedida</small></strong></div><div><span>Objetivo</span><strong>@Cantidad(p.Objetivo,p) <small>@p.UnidadMedida</small></strong></div></div>
                <div class="restock-quantity" @onclick:stopPropagation="true"><label for="@($"restock-qty-{p.ProductoId}")">Cantidad a pedir</label><div><input id="@($"restock-qty-{p.ProductoId}")" class="form-control" type="number" inputmode="decimal" aria-label="@($"Cantidad a pedir de {p.Nombre}")" aria-invalid="@(erroresCantidad.ContainsKey(p.ProductoId) ? "true" : "false")" aria-describedby="@(erroresCantidad.ContainsKey(p.ProductoId) ? $"restock-error-{p.ProductoId}" : null)" min="@(p.EsPorPeso ? "0.001" : "1")" max="99999999.999" step="@(p.EsPorPeso ? "0.001" : "1")" value="@cantidades[p.ProductoId]" disabled="@Bloqueado" @oninput="e => CambiarCantidad(p,e)" /><span>@p.UnidadMedida</span></div>@if (erroresCantidad.TryGetValue(p.ProductoId,out var mensaje)) { <small class="restock-field-error" id="@($"restock-error-{p.ProductoId}")">@mensaje</small> }@if(manuales.Contains(p.ProductoId)) { <button type="button" class="restock-remove-manual" disabled="@Bloqueado" @onclick="()=>QuitarManual(p)">Quitar de la lista</button> }</div>
                <div class="restock-cost"><span>Costo estimado</span><strong>$@p.Estimado.ToString("N2")</strong><small>$@p.PrecioCompra.ToString("N2") / @p.UnidadMedida</small></div>
            </article>
        } }
        <p class="restock-help">La sugerencia usa el objetivo de cada producto. Si no tiene uno definido, usa el doble del mínimo y al menos una unidad. Ajusta lo que necesitas comprar; en Entradas revisarás lo que realmente llegó.</p>
    </div>
    <div class="restock-actions"><div><span>@Seleccionados.Count @(Seleccionados.Count == 1 ? "producto seleccionado" : "productos seleccionados")@if (FueraDelFiltro > 0) { <small> · @FueraDelFiltro fuera del filtro</small> }</span><strong>$@Total.ToString("N2") <small>estimado</small></strong>@if (!CantidadesValidas) { <small class="restock-field-error">Revisa las cantidades de los productos seleccionados.</small> }</div><div><button type="button" class="btn btn-outline-primary restock-print-button" disabled="@(Bloqueado || Seleccionados.Count == 0 || !CantidadesValidas)" @onclick="AbrirLista">Imprimir lista de compra</button><button type="button" class="btn btn-primary" disabled="@(Bloqueado || Seleccionados.Count == 0 || !CantidadesValidas)" @onclick="PrepararEntrada">Preparar recepción</button></div></div>
</div>
@if (mostrarLista)
{
    <div class="modal show d-block restock-print-overlay" role="dialog" aria-modal="true" aria-labelledby="restock-print-title" tabindex="-1" @ref="panelImpresion" @onkeydown="TeclaLista"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><h3 class="modal-title" id="restock-print-title">Lista de compra</h3><button type="button" class="btn-close" aria-label="Cerrar lista de compra" @onclick="CerrarLista"></button></div><div class="modal-body"><section class="restock-print-sheet"><header><strong>Abarrotes Agustín</strong><h2>Lista de compra · Resurtido</h2><p>@fechaLista.ToString("dd/MM/yyyy HH:mm") · @Seleccionados.Count productos</p></header>
        @foreach (var grupo in Seleccionados.GroupBy(NombreProveedor,Comparador).OrderBy(g => g.Key,Comparador)) { <section><h3>@grupo.Key</h3><div class="table-responsive"><table><thead><tr><th>Producto</th><th>Cantidad a pedir</th><th>Costo unitario</th><th>Estimado</th></tr></thead><tbody>@foreach (var p in grupo) { <tr><td>@p.Nombre<small>@p.Codigo</small></td><td>@Cantidad(p.Cantidad,p) @p.UnidadMedida</td><td>$@p.PrecioCompra.ToString("N2")</td><td>$@p.Estimado.ToString("N2")</td></tr> }</tbody></table></div><p class="restock-provider-total">Subtotal: $@grupo.Sum(p => p.Estimado).ToString("N2")</p></section> }
        <div class="restock-print-total"><span>Total estimado</span><strong>$@Total.ToString("N2")</strong></div><p class="restock-help">Estimado con los últimos costos de compra registrados. Esta lista no registra compras ni suma existencias.</p>
    </section></div><div class="modal-footer"><button type="button" class="btn btn-secondary" @onclick="CerrarLista">Volver</button><button type="button" class="btn btn-primary" @onclick="Imprimir">Imprimir</button></div></div></div></div><div class="modal-backdrop show"></div>
}
