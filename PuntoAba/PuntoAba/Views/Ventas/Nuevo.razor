@page "/ventas/nuevo"
<PageTitle>Nueva venta - Abarrotes Agustín</PageTitle>
@{ var borrador = ventaActual; }
<div class="sales-page pos-sale" @ref="raiz">
    <div class="pos-sale-tabs" role="tablist" aria-label="Ventas en curso">
        @for (var i = 0; i < Pedidos.Ventas.Length; i++)
        {
            var indice = i; var pedido = Pedidos.Ventas[i];
            <button type="button" role="tab" id="@($"pos-venta-{i}")" data-sale-tab="@i" aria-label="@($"Venta {i + 1}")" aria-controls="pos-venta-panel" aria-selected="@(Pedidos.Indice == i ? "true" : "false")" tabindex="@(Pedidos.Indice == i ? 0 : -1)"
                    class="pos-sale-tab @(Pedidos.Indice == i ? "is-active" : "") @(pedido.Carrito.Items.Count > 0 ? "has-items" : "")" disabled="@(!PuedeEscanear)" @onclick="() => SeleccionarVenta(indice)">
                <span>Venta @(i + 1)</span><small aria-hidden="true">@(pedido.Carrito.Items.Count > 0 ? $"{pedido.Carrito.Items.Count} {(pedido.Carrito.Items.Count == 1 ? "producto" : "productos")} · ${pedido.Total:N2}" : "Disponible")</small>
            </button>
        }
    </div>
    <div class="sales-container pos-layout" id="pos-venta-panel" role="tabpanel" aria-labelledby="@($"pos-venta-{Pedidos.Indice}")">
        <section class="sales-catalog pos-catalog" aria-label="Catálogo de venta">
            <div class="pos-catalog-header">
                <form class="pos-search" @onsubmit="EnviarBusqueda" @onsubmit:preventDefault="true">
                    <Icono Nombre="buscar" />
                    <input id="pos-busqueda" type="search" data-touch-enter autocomplete="off" spellcheck="false"
                           placeholder="Buscar producto o escanear código…" aria-label="Buscar producto o escanear código"
                           value="@filtro" @oninput="Buscar" disabled="@(cargando || procesando || !Pedidos.Restaurado)" />
                    @if (filtro.Length > 0) { <button type="button" class="pos-icon-btn" aria-label="Limpiar búsqueda" @onclick="LimpiarBusqueda"><Icono Nombre="cerrar" /></button> }
                </form>
                <button type="button" class="pos-scale @(BalanzaService.Conectada ? "is-connected" : "is-disconnected")" @onclick="MostrarEstadoBalanza">
                    <span class="pos-status-dot"></span><span>@(BalanzaService.Conectada ? "Báscula conectada" : "Báscula desconectada")</span>
                    <strong>@(BalanzaService.PesoActual?.ToString("N3") ?? "0.000") @BalanzaService.UnidadMedida</strong>
                </button>
                <div class="pos-categories" aria-label="Categorías de productos">
                    <button type="button" class="@(categoriaActual == 0 ? "is-active" : "")" aria-pressed="@(categoriaActual == 0)" @onclick="() => Categoria(0)">Todos</button>
                    <button type="button" class="@(categoriaActual == -1 ? "is-active" : "")" aria-pressed="@(categoriaActual == -1)" @onclick="() => Categoria(-1)"><Icono Nombre="estrella" />Favoritos</button>
                    @foreach (var c in categorias)
                    { <button type="button" class="@(categoriaActual == c.Id ? "is-active" : "")" aria-pressed="@(categoriaActual == c.Id)" @onclick="() => Categoria(c.Id)">@c.Nombre</button> }
                </div>
                <div class="pos-catalog-meta"><span>@productosFiltrados.Count productos · @(categoriaActual == 0 ? "Más vendidos · 30 días" : categoriaActual == -1 ? "Tu selección" : "Orden A–Z")</span>
                    @if (categoriaActual == -1 && favoritos.Count > 1) { <button type="button" @onclick="() => mostrarFavoritos = true">Ordenar favoritos</button> }
                </div>
                @if (mensajeEscaner.Length > 0) { <p class="pos-notice @(errorEscaner ? "is-error" : "")" role="status">@mensajeEscaner</p> }
            </div>
            <div class="pos-catalog-scroll" tabindex="0" aria-label="Lista de productos">
                <CatalogoProductos Cargando="@(cargando || !Pedidos.Restaurado)" Productos="productosFiltrados" Visibles="visibles" Favoritos="favoritos" OnAgregar="AgregarAlCarrito" OnFavorito="AlternarFavorito" />
                <div class="pos-load-more" data-pos-sentinel>
                    @if (visibles < productosFiltrados.Count) { <button type="button" @onclick="CargarMas">Mostrar más productos</button> }
                </div>
                <button type="button" class="pos-back-top" data-pos-top hidden><Icono Nombre="arriba" />Volver arriba</button>
            </div>
        </section>
        <div class="pos-divider" role="separator" tabindex="0" aria-label="Ajustar ancho del catálogo y carrito" aria-orientation="vertical" aria-valuemin="30" aria-valuemax="70" aria-valuenow="55" title="Arrastra para ajustar. Doble clic o doble toque para restablecer."><span></span></div>
        <section class="sales-cart pos-cart" aria-label="Carrito y cobro" aria-busy="@procesando" @key="borrador">
            <LineasCarrito Items="carrito" OnSumar="AumentarCantidad" OnRestar="DisminuirCantidad" OnEliminar="EliminarDelCarrito" OnCantidad="CambiarCantidad" OnPeso="EditarPeso" />
            <div class="pos-summary">
                    <div><span>Subtotal</span><strong>$@subtotal.ToString("N2")</strong></div>
                    <div class="pos-discount-row"><span class="pos-money-input">$<input id="pos-descuento" data-pos-next=".pos-charge" aria-label="Descuento" placeholder="Descuento" type="number" data-pos-numeric inputmode="decimal" min="0" max="@subtotal" step="0.01" @bind="borrador.Descuento" @bind:event="oninput" /></span></div>
                    <div><button type="button" class="pos-tax-toggle @(aplicarImpuesto ? "is-active" : "")" aria-pressed="@aplicarImpuesto" @onclick="() => aplicarImpuesto = !aplicarImpuesto"><span></span>Impuesto</button>
                        <span class="pos-tax-value">@if (aplicarImpuesto) { <input type="number" data-pos-next=".pos-charge" aria-label="Porcentaje de impuesto" data-pos-numeric inputmode="decimal" min="0" max="100" step="0.1" @bind="borrador.PorcentajeImpuesto" @bind:event="oninput" /><span>%</span> }<strong>$@iva.ToString("N2")</strong></span></div>
                    <div class="pos-total"><span>Total</span><strong>$@total.ToString("N2")</strong></div>
                </div>
            <div class="pos-checkout-controls">
                <div class="pos-customer" role="group" aria-label="Cliente">
                    <div class="pos-client-buttons"><button type="button" class="@(clienteSeleccionado == 1 ? "is-active" : "")" @onclick="() => clienteSeleccionado = 1">Cliente general</button><button type="button" class="@(clienteSeleccionado != 1 ? "is-active" : "")" @onclick="AbrirModalClientes"><Icono Nombre="clientes" />Elegir cliente</button></div>
                    @if (clienteSeleccionado != 1) { <small>@clientes.FirstOrDefault(c => c.Id == clienteSeleccionado)?.NombreCompleto</small> }
                </div>
                <div class="pos-payment" role="group" aria-label="Método de pago">
                    <div class="pos-payment-methods">@foreach (var m in metodos) { <button type="button" class="@(metodoPago == m.Nombre ? "is-active" : "")" aria-pressed="@(metodoPago == m.Nombre)" @onclick="() => metodoPago = m.Nombre"><Icono Nombre="@m.Icono" /><span>@m.Nombre</span></button> }</div>
                    @if (metodoPago != "Efectivo") { <p class="pos-payment-note">El cobro con @metodoPago.ToLowerInvariant() estará disponible en la siguiente etapa.</p> }
                </div>
            </div>
            <div class="pos-checkout-actions">
                @if (errorVenta.Length > 0 && !mostrarModalCobro) { <p class="pos-notice is-error" role="alert">@errorVenta</p> }
                @if (!ventaActual.ProductosActivos) { <p class="pos-notice is-error" role="alert">Hay productos inactivos o retirados. Revisa esta venta antes de cobrar.</p> }
                <button type="button" class="pos-charge" disabled="@(!PuedeAbrirCobro)" @onclick="AbrirCobro"><span>@(procesando ? "Procesando…" : "Cobrar")</span><strong>$@total.ToString("N2")</strong></button>
                <button type="button" class="pos-cancel" disabled="@procesando" @onclick="SolicitarCancelar">Cancelar venta</button>
            </div>
        </section>
    </div>
    @if (mostrarModalCobro)
    {
        <div class="pos-modal-overlay"><section class="pos-dialog pos-cash-dialog" role="dialog" aria-modal="true" aria-labelledby="pos-cash-title" tabindex="-1" aria-busy="@(procesando ? "true" : "false")">
            <div class="pos-dialog-heading"><h2 id="pos-cash-title">Cobrar Venta @(Pedidos.Indice + 1)</h2><button type="button" class="pos-icon-btn" disabled="@procesando" aria-label="Cerrar cobro" @onclick="CerrarCobro"><Icono Nombre="cerrar" /></button></div>
            <div class="pos-cash-total"><span>Total</span><strong>$@ventaActual.TotalEfectivo.ToString("N2")</strong></div>
            <div class="pos-cash">
                <span class="pos-money-input">$<input id="pos-recibido" data-pos-enter="[data-pos-confirm]" aria-label="Recibido" aria-describedby="pos-cash-help" placeholder="Recibido" type="number" data-pos-numeric inputmode="decimal" min="0" step="0.01" @bind="borrador.Recibido" @bind:event="oninput" disabled="@procesando" /></span>
                <p id="pos-cash-help" class="pos-cash-help" role="status">@AyudaCobro</p>
                <div class="pos-change" role="status" aria-live="polite"><span>Cambio</span><strong>$@ventaActual.Cambio.ToString("N2")</strong></div>
            </div>
            @if (errorVenta.Length > 0) { <p class="pos-notice is-error" role="alert">@errorVenta</p> }
            <div class="pos-dialog-actions"><button type="button" class="pos-secondary" disabled="@procesando" @onclick="CerrarCobro">Volver</button><button type="button" class="pos-primary" data-pos-confirm aria-keyshortcuts="Enter" disabled="@(procesando || !ventaActual.EfectivoValido || !TotalesValidos || !ventaActual.ProductosActivos || carrito.Count == 0)" @onclick="ProcesarVenta">@(procesando ? "Confirmando…" : "Confirmar")</button></div>
        </section></div>
    }
    @if (mostrarModalClientes)
    {
        <div class="pos-modal-overlay"><section class="pos-dialog" role="dialog" aria-modal="true" aria-labelledby="pos-client-title" tabindex="-1">
            <div class="pos-dialog-heading"><h2 id="pos-client-title">Elegir cliente</h2><button type="button" class="pos-icon-btn" aria-label="Cerrar clientes" @onclick="CerrarVentanas"><Icono Nombre="cerrar" /></button></div>
            <input class="pos-dialog-search" data-pos-enter=".pos-client-list button:only-child" type="search" aria-label="Buscar cliente" placeholder="Buscar cliente…" @bind="buscarCliente" @bind:event="oninput" />
            <div class="pos-client-list">@foreach (var c in clientesFiltradosBusqueda) { <button type="button" @onclick="() => ElegirCliente(c.Id)"><strong>@c.NombreCompleto</strong><small>@c.DocumentoIdentidad</small></button> }@if (clientesFiltradosBusqueda.Count == 0) { <p>No se encontraron clientes.</p> }</div>
        </section></div>
    }
    @if (mostrarModalPeso && productoPesoSeleccionado != null)
    {
        <div class="pos-modal-overlay"><section class="pos-dialog" role="dialog" aria-modal="true" aria-labelledby="pos-weight-title" tabindex="-1">
            <div class="pos-dialog-heading"><h2 id="pos-weight-title">@(editandoPeso ? "Editar cantidad" : "Cantidad")</h2><button type="button" class="pos-icon-btn" aria-label="Cerrar cantidad" @onclick="CerrarModalPeso"><Icono Nombre="cerrar" /></button></div>
            <div class="pos-weight-product"><strong>@productoPesoSeleccionado.Nombre</strong><span>$@productoPesoSeleccionado.PrecioVenta.ToString("N2") / @productoPesoSeleccionado.UnidadMedida</span></div>
            <div class="pos-weight-modes"><button type="button" class="@(modoCapturaPeso == "balanza" ? "is-active" : "")" disabled="@(!UnidadCompatible(productoPesoSeleccionado))" @onclick='() => CambiarModoCapturaPeso("balanza")'><Icono Nombre="balanza" />Báscula</button><button type="button" class="@(modoCapturaPeso == "manual" ? "is-active" : "")" @onclick='() => CambiarModoCapturaPeso("manual")'><Icono Nombre="teclado" />Manual</button></div>
            <p class="pos-weight-state" role="status">@(modoCapturaPeso == "manual" ? (BalanzaService.Conectada ? "Captura manual: la báscula no modificará esta cantidad." : "Báscula desconectada. Puedes escribir la cantidad.") : PesoEstable.HasValue ? "Peso estable" : "Esperando un peso válido y estable…")</p>
            <label for="pos-peso">Cantidad (@productoPesoSeleccionado.UnidadMedida)</label>
            <input id="pos-peso" data-pos-enter="[data-pos-weight-confirm]" class="pos-weight-input" type="text" inputmode="decimal" autocomplete="off" @bind="pesoCaptura" @bind:event="oninput" readonly="@(modoCapturaPeso == "balanza")" />
            <p class="pos-weight-equivalent">@EquivalenciaPeso</p>
            <div class="pos-weight-total"><span>Importe</span><strong>$@CalcularSubtotalPeso().ToString("N2")</strong></div>
            @if (errorPeso.Length > 0) { <p class="pos-notice is-error" role="alert">@errorPeso</p> }
            <div class="pos-dialog-actions"><button type="button" class="pos-secondary" @onclick="CerrarModalPeso">Cancelar</button><button type="button" class="pos-primary" data-pos-weight-confirm disabled="@(!CantidadPesoValida)" @onclick="ConfirmarPeso">@(editandoPeso ? "Guardar cantidad" : "Agregar")</button></div>
        </section></div>
    }
    @if (mostrarCancelar)
    {
        <div class="pos-modal-overlay"><section class="pos-dialog" role="dialog" aria-modal="true" aria-labelledby="pos-cancel-title" tabindex="-1">
            <div class="pos-dialog-heading"><h2 id="pos-cancel-title">¿Cancelar Venta @(Pedidos.Indice + 1)?</h2></div><p>Se quitarán los productos del carrito. El inventario no cambiará.</p>
            <div class="pos-dialog-actions"><button type="button" class="pos-secondary" @onclick="CerrarVentanas">Seguir vendiendo</button><button type="button" class="pos-danger" @onclick="CancelarVenta">Cancelar venta</button></div>
        </section></div>
    }
    @if (mostrarFavoritos)
    {
        <div class="pos-modal-overlay"><section class="pos-dialog" role="dialog" aria-modal="true" aria-labelledby="pos-fav-title" tabindex="-1">
            <div class="pos-dialog-heading"><h2 id="pos-fav-title">Ordenar favoritos</h2><button type="button" class="pos-icon-btn" aria-label="Cerrar favoritos" @onclick="CerrarVentanas"><Icono Nombre="cerrar" /></button></div>
            @foreach (var id in favoritos.ToList())
            { var p = productos.FirstOrDefault(x => x.Id == id); if (p != null) { <div class="pos-favorite-row"><span>@p.Nombre</span><button type="button" aria-label="@($"Subir {p.Nombre}")" disabled="@(favoritos.IndexOf(id) == 0)" @onclick="() => MoverFavorito(id, -1)">↑</button><button type="button" aria-label="@($"Bajar {p.Nombre}")" disabled="@(favoritos.IndexOf(id) == favoritos.Count - 1)" @onclick="() => MoverFavorito(id, 1)">↓</button></div> } }
        </section></div>
    }
</div>
