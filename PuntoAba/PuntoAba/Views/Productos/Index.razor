@page "/productos"
@using Microsoft.AspNetCore.Components.Forms
@implements IAsyncDisposable
@inject IProductoService ProductoService
@inject ICategoriaService CategoriaService
@inject ILoggerFactory LoggerFactory
@inject NavigationManager Navigation
@inject IImagenProductoService ImagenService
@inject IJSRuntime JS

<PageTitle>Productos - PuntoAba</PageTitle>

<div class="productos-page">
    <div class="page-header">
        <div><h2 class="page-title">Productos</h2><p class="inv-description">Administra el catálogo, los precios y las reglas de resurtido.</p></div>
        <button class="btn btn-primary" @onclick="() => MostrarModal(null)">
             Nuevo Producto
        </button>
    </div>

    @if (exitoListado != "") { <div class="alert alert-success" role="status">@exitoListado</div> }
    @if (errorListado != "") { <div class="alert alert-danger" role="alert">@errorListado</div> }
    <div class="inv-summary inv-summary-compact"><div><span>Productos activos</span><strong>@productos.Count</strong></div><div><span>Stock bajo</span><strong>@productos.Count(p => p.Stock > 0 && p.Stock <= p.StockMinimo)</strong></div><div><span>Sin stock</span><strong>@productos.Count(p => p.Stock <= 0)</strong></div></div>
    <div class="filters-section">
        <div class="row g-3">
            <div class="col-md-6">
                <input type="text" class="form-control" aria-label="Buscar productos" placeholder="Buscar por nombre o código" @bind="filtro" @bind:event="oninput" @bind:after="Filtrar" />
            </div>
            <div class="col-md-3">
                <select aria-label="Filtrar productos por categoría" class="form-select" @bind="categoriaFiltro" @bind:after="Filtrar">
                    <option value="0">Todas las categorías</option>
                    @foreach (var cat in categorias)
                    {
                        <option value="@cat.Id">@cat.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select aria-label="Filtrar productos por existencias" class="form-select" @bind="stockFiltro" @bind:after="Filtrar">
                    <option value="0">Todos</option>
                    <option value="1">Stock bajo</option>
                    <option value="2">Sin stock</option>
                </select>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="loading-spinner">
            <div class="spinner-border" role="status"></div>
        </div>
    }
    else
    {
        <div class="card"><div class="card-header"><span>Catálogo de productos</span><small>@productosFiltrados.Count resultados</small></div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Tipo</th>
                                <th class="text-end">P. Compra</th>
                                <th class="text-end">P. Venta</th>
                                <th class="text-center">Stock</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var producto in productosFiltrados)
                            {
                                <tr>
                                    <td><strong>@producto.Codigo</strong></td>
                                    <td>@producto.Nombre</td>
                                    <td>@producto.CategoriaNombre</td>
                                    <td>
                                        <span class="badge @(producto.EsPorPeso ? "bg-info" : "bg-secondary")">
                                            @(producto.EsPorPeso ? $"Por {producto.UnidadMedida ?? "peso"}" : "Por unidad")
                                        </span>
                                    </td>
                                    <td class="text-end">$@producto.PrecioCompra.ToString("N2")</td>
                                    <td class="text-end"><strong>$@producto.PrecioVenta.ToString("N2")</strong></td>
                                    <td class="text-center">
                                        <span class="badge @(producto.Stock <= 0 ? "bg-danger" : producto.Stock <= producto.StockMinimo ? "bg-warning" : "bg-success")">
                                            @(producto.EsPorPeso ? producto.Stock.ToString("N3") : producto.Stock.ToString("N0"))
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(producto.Activo ? "bg-success" : "bg-secondary")">
                                            @(producto.Activo ? "Activo" : "Inactivo")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <button class="btn btn-outline-primary" @onclick="() => MostrarModal(producto)" title="Editar"><Icono Nombre="editar" /><span>Editar</span></button>
                                            <button class="btn btn-outline-info" @onclick="() => AjustarStock(producto)" title="Ajustar Stock"><Icono Nombre="ajustes" /><span>Ajustar</span></button>
                                            <button class="btn btn-outline-danger" @onclick="() => Eliminar(producto.Id)" title="Eliminar"><Icono Nombre="eliminar" /><span>Eliminar</span></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            @if (productosFiltrados.Count == 0) { <tr><td colspan="9" class="inv-empty">No hay productos con estos filtros.</td></tr> }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <p class="text-muted">Total: @productosFiltrados.Count productos</p>
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="modal show d-block inv-catalog-modal product-editor" role="dialog" aria-modal="true" aria-labelledby="product-modal-title" tabindex="-1" @ref="editor" @onkeydown="TeclaEditor">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header"><div><h2 class="modal-title" id="product-modal-title">@(esEdicion ? "Editar producto" : "Nuevo producto")</h2><p>Escanea, completa los datos principales y guarda.</p></div><button type="button" class="btn-close" aria-label="Cerrar producto" disabled="@guardando" @onclick="CerrarModal"></button></div>
            <div class="modal-body">
                @if (mensajeFormulario != "") { <p class="product-saved" role="status">@mensajeFormulario</p> }
                @if (errorGuardar != "") { <div class="alert alert-danger" role="alert">@errorGuardar</div> }
                <EditForm Model="productoEditar" @key="productoEditar" @ref="formularioProducto" OnSubmit="IgnorarEnvio">
                    <DataAnnotationsValidator /><ValidationSummary />
                    <fieldset disabled="@guardando" class="product-fieldset">
                        <div class="product-identity">
                            <div><label for="producto-codigo">Código de barras *</label><input id="producto-codigo" class="form-control" autocomplete="off" spellcheck="false" placeholder="Escanea o escribe el código" data-product-next @bind="productoEditar.Codigo" @bind:event="oninput" /><ValidationMessage For="@(() => productoEditar.Codigo)" /></div>
                            <div><label for="producto-nombre">Nombre del producto *</label><InputText id="producto-nombre" class="form-control" placeholder="Ej. Leche entera 1 L" data-product-next @bind-Value="productoEditar.Nombre" /><ValidationMessage For="@(() => productoEditar.Nombre)" /></div>
                        </div>
                        <div class="product-main-grid">
                            <section class="product-block" aria-labelledby="product-sale-heading"><h3 id="product-sale-heading">Datos de venta</h3>
                                <div class="product-field"><label for="producto-categoria">Categoría *</label><InputSelect id="producto-categoria" class="form-select" @bind-Value="productoEditar.CategoriaId"><option value="0">Selecciona una categoría</option>@foreach (var cat in categorias) { <option value="@cat.Id">@cat.Nombre</option> }</InputSelect><ValidationMessage For="@(() => productoEditar.CategoriaId)" /></div>
                                <div class="product-pair">
                                    <div><label for="product-buy-price">Precio de compra *</label><div class="product-money"><span>$</span><InputNumber id="product-buy-price" class="form-control" placeholder="Compra" inputmode="decimal" min="0" step="0.01" data-product-next @bind-Value="precioCompraCaptura" /></div></div>
                                    <div><label for="product-sell-price">Precio de venta *</label><div class="product-money"><span>$</span><InputNumber id="product-sell-price" class="form-control" placeholder="Venta" inputmode="decimal" min="0" step="0.01" data-product-next @bind-Value="precioVentaCaptura" /></div></div>
                                </div>
                            </section>
                            <section class="product-block" aria-labelledby="product-stock-heading"><h3 id="product-stock-heading">Forma de venta y existencias</h3>
                                <div class="product-sale-mode" role="group" aria-label="Forma de venta"><button type="button" class="@(!productoEditar.EsPorPeso ? "is-active" : "")" aria-pressed="@(!productoEditar.EsPorPeso ? "true" : "false")" @onclick="() => CambiarTipo(false)">Por pieza</button><button type="button" class="@(productoEditar.EsPorPeso ? "is-active" : "")" aria-pressed="@(productoEditar.EsPorPeso ? "true" : "false")" @onclick="() => CambiarTipo(true)">Por peso</button></div>
                                <div class="product-field product-unit"><label for="product-unit">Unidad de medida</label><InputText id="product-unit" class="form-control" list="product-units" placeholder="@(productoEditar.EsPorPeso ? "Kg" : "Pieza")" @bind-Value="productoEditar.UnidadMedida" /><datalist id="product-units"><option value="Pieza"/><option value="Kg"/><option value="g"/><option value="Lt"/></datalist></div>
                                <div class="product-pair">
                                    <div><label for="product-initial-stock">@(esEdicion ? "Existencias actuales" : "Existencias iniciales")</label>
                                        @if (esEdicion) { <input id="product-initial-stock" type="text" class="form-control" value="@stockActualEdicion.ToString(productoEditar.EsPorPeso ? "N3" : "N0")" readonly /> }
                                        else { <InputNumber id="product-initial-stock" class="form-control" min="0" step="@(productoEditar.EsPorPeso ? "0.001" : "1")" inputmode="decimal" data-product-next @bind-Value="productoEditar.Stock" /><ValidationMessage For="@(() => productoEditar.Stock)" /> }
                                    </div>
                                    <div><label for="product-min-stock">Mínimo de existencias</label><InputNumber id="product-min-stock" class="form-control" min="0" step="@(productoEditar.EsPorPeso ? "0.001" : "1")" inputmode="decimal" data-product-next @bind-Value="productoEditar.StockMinimo" /><ValidationMessage For="@(() => productoEditar.StockMinimo)" /></div>
                                </div>
                                @if (esEdicion) { <small>Para cambiar existencias usa Entradas, Ajustes o Conteo físico.</small> }
                            </section>
                        </div>
                        <button type="button" class="product-options-toggle" aria-expanded="@(mostrarOpciones ? "true" : "false")" aria-controls="product-options" @onclick="() => mostrarOpciones = !mostrarOpciones"><span><strong>Más opciones</strong><small>Foto, descripción, proveedor y resurtido</small></span><Icono Nombre="@(mostrarOpciones ? "arriba" : "derecha")" /></button>
                        <div id="product-options" class="product-options" hidden="@(!mostrarOpciones)">
                            <div class="product-options-grid"><div><label for="product-description">Descripción</label><InputTextArea id="product-description" class="form-control" rows="2" @bind-Value="productoEditar.Descripcion" /><div class="product-pair"><div><label for="producto-proveedor">Proveedor habitual</label><InputText id="producto-proveedor" class="form-control" maxlength="200" @bind-Value="productoEditar.ProveedorHabitual" /></div><div><label for="producto-objetivo">Objetivo de resurtido</label><InputNumber id="producto-objetivo" class="form-control" min="0" step="@(productoEditar.EsPorPeso ? "0.001" : "1")" @bind-Value="productoEditar.StockObjetivo" /><small>0 usa el objetivo automático.</small></div></div></div>
                                <div class="product-image-field"><label for="product-image">Imagen del producto</label><div class="product-image-preview">@if (imagenPreview != "") { <img src="@imagenPreview" alt="Vista previa del producto" /> } else { <Icono Nombre="caja" /><span>Sin imagen</span> }</div><InputFile id="product-image" OnChange="CargarImagen" class="form-control" accept="image/jpeg,image/jpg,image/png,image/gif,image/webp" disabled="@guardando" /><small>JPG, PNG, GIF o WEBP · Máximo 5 MB</small></div>
                            </div>
                        </div>
                    </fieldset>
                </EditForm>
            </div>
            <div class="modal-footer product-editor-footer"><button type="button" class="btn btn-secondary" disabled="@guardando" @onclick="CerrarModal">Cancelar</button><div>@if (!esEdicion) { <button type="button" class="btn btn-outline-primary" disabled="@guardando" @onclick="() => GuardarValidado(true)">Guardar y agregar otro</button> }<button type="button" class="btn btn-primary" data-product-save disabled="@guardando" @onclick="() => GuardarValidado(false)">@(guardando ? "Guardando…" : "Guardar")</button></div></div>
        </div></div>
    </div><div class="modal-backdrop show"></div>
}

@code {
    private List<ProductoDto> productos = new();
    private List<ProductoDto> productosFiltrados = new();
    private List<CategoriaDto> categorias = new();
    private bool loading = true;
    private bool mostrarModal = false;
    private CrearProductoDto productoEditar = new();
    private bool esEdicion = false;
    private int productoIdEditando = 0;
    private decimal stockActualEdicion;
    private string filtro = "";
    [SupplyParameterFromQuery(Name = "categoriaId")] public int? CategoriaInicial { get; set; }
    private int? categoriaAplicada;
    private int categoriaFiltro = 0;
    protected override void OnParametersSet()
    {
        if (categoriaAplicada == CategoriaInicial) return;
        categoriaAplicada = CategoriaInicial;
        categoriaFiltro = CategoriaInicial is > 0 ? CategoriaInicial.Value : 0;
        filtro = ""; stockFiltro = 0;
        Filtrar();
    }
    private int stockFiltro = 0;
    private IBrowserFile? archivoImagen;
    private string imagenPreview = "";
    private EditForm? formularioProducto;
    private bool guardando;
    private bool mostrarOpciones, enfocarCodigo;
    private decimal? precioCompraCaptura, precioVentaCaptura;
    private string mensajeFormulario = "";
    private ElementReference editor;
    private IJSObjectReference? editorJs;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mostrarModal || !enfocarCodigo || guardando) return;
        enfocarCodigo = false;
        editorJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/producto-form.mjs?v=1");
        await editorJs.InvokeVoidAsync("preparar", editor);
    }
    private void TeclaEditor(KeyboardEventArgs e) { if (e.Key == "Escape") CerrarModal(); }
    private void CambiarTipo(bool porPeso)
    {
        if (guardando || productoEditar.EsPorPeso == porPeso) return;
        productoEditar.EsPorPeso = porPeso;
        productoEditar.UnidadMedida = porPeso ? "Kg" : "Pieza";
    }
    private void NuevoBorrador(int categoria = 0)
    {
        productoEditar = new() { CategoriaId = categoria, UnidadMedida = "Pieza", StockMinimo = 10 };
        precioCompraCaptura = precioVentaCaptura = null;
        archivoImagen = null; imagenPreview = ""; errorGuardar = "";
        mostrarOpciones = false; enfocarCodigo = true;
    }
    public async ValueTask DisposeAsync()
    {
        if (editorJs == null) return;
        try { await editorJs.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
    private string errorGuardar = "";
    private string exitoListado = "", errorListado = "";

    protected override async Task OnInitializedAsync() => await CargarDatos();

    private async Task CargarImagen(InputFileChangeEventArgs e)
    {
        try
        {
            var archivo = e.File;

            if (archivo == null)
            {
                return;
            }

            // Validar tipo de archivo
            var tiposPermitidos = new[] { "image/jpeg", "image/jpg", "image/png", "image/gif", "image/webp" };
            if (!tiposPermitidos.Contains(archivo.ContentType.ToLower()))
            {
                await JS.InvokeVoidAsync("alert", "Solo se permiten imágenes JPG, PNG, GIF o WEBP");
                return;
            }

            // Validar tamaño (máx 5MB)
            const long maxFileSize = 5242880; // 5MB
            if (archivo.Size > maxFileSize)
            {
                await JS.InvokeVoidAsync("alert", "La imagen no debe superar 5MB");
                return;
            }

            // Guardar referencia del archivo
            archivoImagen = archivo;

            // Crear preview usando un stream
            using var stream = archivo.OpenReadStream(maxFileSize);
            using var memoryStream = new MemoryStream();
            await stream.CopyToAsync(memoryStream);
            var imageBytes = memoryStream.ToArray();
            var base64 = Convert.ToBase64String(imageBytes);
            imagenPreview = $"data:{archivo.ContentType};base64,{base64}";

            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Error al cargar la imagen: {ex.Message}");
            archivoImagen = null;
            imagenPreview = "";
            StateHasChanged();
        }
    }

    private async Task<string?> GuardarImagenFisicamente()
    {
        if (archivoImagen == null) return null;
        await using var stream = archivoImagen.OpenReadStream(ImagenProductoService.MaximoBytes);
        return await ImagenService.GuardarAsync(stream, archivoImagen.ContentType);
    }

    private async Task CargarDatos()
    {
        loading = true;
        try
        {
            productos = (await ProductoService.ObtenerTodosAsync()).OrderBy(p => p.Nombre, StringComparer.CurrentCultureIgnoreCase).ToList();
            Filtrar();

            categorias = await CategoriaService.ObtenerTodasAsync();
        }
        finally
        {
            loading = false;
        }
    }

    private void Filtrar()
    {
        productosFiltrados = productos;

        if (!string.IsNullOrWhiteSpace(filtro))
        {
            productosFiltrados = productosFiltrados.Where(p =>
                p.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                p.Codigo.Contains(filtro, StringComparison.OrdinalIgnoreCase)
            ).ToList();
        }

        if (categoriaFiltro > 0)
        {
            productosFiltrados = productosFiltrados.Where(p => p.CategoriaId == categoriaFiltro).ToList();
        }

        if (stockFiltro == 1)
        {
            productosFiltrados = productosFiltrados.Where(p => p.Stock <= p.StockMinimo && p.Stock > 0).ToList();
        }
        else if (stockFiltro == 2)
        {
            productosFiltrados = productosFiltrados.Where(p => p.Stock <= 0).ToList();
        }
    }

    private void MostrarModal(ProductoDto? producto)
    {
        errorGuardar = exitoListado = errorListado = mensajeFormulario = "";
        mostrarOpciones = false;
        archivoImagen = null;
        imagenPreview = "";

        if (producto == null)
        {
            NuevoBorrador();
            esEdicion = false;
            productoIdEditando = 0;
        }
        else
        {
            productoEditar = new CrearProductoDto
            {
                Codigo = producto.Codigo,
                Nombre = producto.Nombre,
                Descripcion = producto.Descripcion,
                PrecioCompra = producto.PrecioCompra,
                PrecioVenta = producto.PrecioVenta,
                // El stock inicial solo se captura al crear; en edición se muestra por separado.
                Stock = 0,
                StockMinimo = producto.StockMinimo,
StockObjetivo = producto.StockObjetivo, ProveedorHabitual = producto.ProveedorHabitual,
                CategoriaId = producto.CategoriaId,
                UnidadMedida = producto.UnidadMedida,
                EsPorPeso = producto.EsPorPeso,
                ImagenUrl = producto.ImagenUrl
            };
            precioCompraCaptura = producto.PrecioCompra; precioVentaCaptura = producto.PrecioVenta;
            stockActualEdicion = producto.Stock;
            imagenPreview = producto.ImagenUrl ?? "";
            esEdicion = true;
            productoIdEditando = producto.Id;
        }
        mostrarModal = true; enfocarCodigo = true;
    }

    private void CerrarModal()
    {
        if (guardando) return;
        mostrarModal = false;
    }

    // El lector envía Enter. Solo el botón Guardar inicia la validación y el guardado.
    private void IgnorarEnvio(EditContext contexto) { }

    private async Task GuardarValidado(bool agregarOtro)
    {
        if (guardando) return;
        errorGuardar = mensajeFormulario = "";
        if (!precioCompraCaptura.HasValue || !precioVentaCaptura.HasValue)
        { errorGuardar = "Captura el precio de compra y el de venta. Puedes escribir 0 si corresponde."; }
        productoEditar.PrecioCompra = precioCompraCaptura ?? 0;
        productoEditar.PrecioVenta = precioVentaCaptura ?? 0;
        var valido = formularioProducto?.EditContext?.Validate() == true;
        if (!valido)
        {
            var contexto = formularioProducto?.EditContext;
            mostrarOpciones |= new[] { nameof(CrearProductoDto.Descripcion), nameof(CrearProductoDto.ProveedorHabitual), nameof(CrearProductoDto.StockObjetivo) }
                .Any(campo => contexto?.GetValidationMessages(new FieldIdentifier(productoEditar, campo)).Any() == true);
        }
        if (valido && errorGuardar == "") await Guardar(agregarOtro && !esEdicion);
    }

    private async Task Guardar(bool agregarOtro)
    {
        if (guardando) return;
        guardando = true;
        try
        {
            // Guardar imagen si se seleccionó una nueva
            if (archivoImagen != null)
            {
                var rutaImagen = await GuardarImagenFisicamente();
                if (!string.IsNullOrEmpty(rutaImagen))
                {
                    productoEditar.ImagenUrl = rutaImagen;
                }
                else
                {
                    // Si falló el guardado de imagen pero el usuario quiere continuar
                    var continuar = await JS.InvokeAsync<bool>("confirm", "No se pudo guardar la imagen. ¿Desea continuar sin imagen?");
                    if (!continuar)
                    {
                        return;
                    }
                }
            }

            if (esEdicion)
            {
                await ProductoService.ActualizarAsync(productoIdEditando, new ActualizarProductoDto
                {
                    Codigo = productoEditar.Codigo,
                    Nombre = productoEditar.Nombre,
                    Descripcion = productoEditar.Descripcion,
                    PrecioCompra = productoEditar.PrecioCompra,
                    PrecioVenta = productoEditar.PrecioVenta,

                    StockMinimo = productoEditar.StockMinimo,
StockObjetivo = productoEditar.StockObjetivo, ProveedorHabitual = productoEditar.ProveedorHabitual,
                    CategoriaId = productoEditar.CategoriaId,
                    UnidadMedida = productoEditar.UnidadMedida,
                    EsPorPeso = productoEditar.EsPorPeso,
                    ImagenUrl = productoEditar.ImagenUrl
                });
            }
            else
            {
                await ProductoService.CrearAsync(productoEditar);
            }

            // Limpiar estado de imagen
            archivoImagen = null;
            imagenPreview = "";

            var nombreGuardado = productoEditar.Nombre;
            var categoriaGuardada = productoEditar.CategoriaId;
            exitoListado = $"Se guardó {nombreGuardado}.";
            if (agregarOtro)
            {
                NuevoBorrador(categoriaGuardada);
                mensajeFormulario = $"Se guardó {nombreGuardado}. Escanea el siguiente producto.";
            }
            else mostrarModal = false;
            try { await CargarDatos(); }
            catch (Exception ex)
            {
                LoggerFactory.CreateLogger("Productos").LogError(ex, "Producto guardado; no se pudo actualizar el catálogo");
                errorListado = "El producto se guardó, pero no se pudo actualizar el catálogo. Vuelve a abrir Productos.";
                if (agregarOtro) mensajeFormulario += " No se pudo actualizar el catálogo; vuelve a abrir Productos para revisarlo.";
            }
        }
        catch (Exception ex)
        {
            LoggerFactory.CreateLogger("Productos").LogError(ex, "Error al guardar el producto");
            errorGuardar = ex is ArgumentException or System.ComponentModel.DataAnnotations.ValidationException or InvalidOperationException or UnauthorizedAccessException
                ? ex.Message
                : "No se pudo guardar el producto. Revisa los datos e inténtalo de nuevo.";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task Eliminar(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "¿Está seguro de eliminar este producto?"))
        {
            try
            {
                await ProductoService.EliminarAsync(id);
                await CargarDatos();
                errorListado = ""; exitoListado = "Producto eliminado correctamente.";
            }
            catch (Exception ex)
            {
                exitoListado = ""; errorListado = ex.Message;
            }
        }
    }

    private void AjustarStock(ProductoDto producto) => Navigation.NavigateTo($"inventario/correcciones?vista=manual&productoId={producto.Id}");
}
