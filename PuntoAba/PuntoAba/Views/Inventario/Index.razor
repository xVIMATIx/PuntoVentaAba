@page "/inventario"
<PageTitle>Inventario - Abarrotes Agustín</PageTitle>

<section class="inventory-overview" aria-labelledby="inventory-title">
    <div class="inventory-heading">
        <div><h2 id="inventory-title">Consultar inventario</h2><p>Revisa las existencias y detecta qué productos necesitan atención.</p></div>
        <button type="button" class="inventory-refresh" disabled="@cargando" @onclick="Actualizar"><Icono Nombre="actualizar" /><span>@(cargando ? "Actualizando…" : "Actualizar")</span></button>
    </div>
    @if (error.Length > 0) { <p class="inventory-error" role="alert">@error</p> }
    <div class="inventory-stats" aria-label="Resumen de existencias">
        <button type="button" class="inventory-stat @(estadoActual == "" ? "is-selected" : "")" aria-pressed="@(estadoActual == "" ? "true" : "false")" @onclick='() => CambiarEstado("")'><span>Productos activos</span><strong>@productos.Count</strong><small>Ver todo el inventario</small></button>
        <button type="button" class="inventory-stat @(estadoActual == "disponibles" ? "is-selected" : "")" aria-pressed="@(estadoActual == "disponibles" ? "true" : "false")" @onclick='() => CambiarEstado("disponibles")'><span>Existencia normal</span><strong>@productos.Count(p => p.Stock > 0 && p.Stock > p.StockMinimo)</strong><small>Por encima del mínimo</small></button>
        <button type="button" class="inventory-stat is-low @(estadoActual == "bajo" ? "is-selected" : "")" aria-pressed="@(estadoActual == "bajo" ? "true" : "false")" @onclick='() => CambiarEstado("bajo")'><span>Stock bajo</span><strong>@productos.Count(p => p.Stock > 0 && p.Stock <= p.StockMinimo)</strong><small>Requieren resurtido</small></button>
        <button type="button" class="inventory-stat is-empty @(estadoActual == "agotados" ? "is-selected" : "")" aria-pressed="@(estadoActual == "agotados" ? "true" : "false")" @onclick='() => CambiarEstado("agotados")'><span>Sin stock</span><strong>@productos.Count(p => p.Stock <= 0)</strong><small>Saldo cero o negativo</small></button>
    </div>
    <section class="inventory-card" aria-labelledby="inventory-products-title">
        <div class="inventory-card-heading"><h3 id="inventory-products-title">Existencias de productos</h3><span>@(consultado.HasValue ? $"Actualizado {consultado.Value:dd/MM/yyyy · HH:mm}" : "Consultando existencias…")</span></div>
        <div class="inventory-filters">
            <div class="inventory-search"><Icono Nombre="buscar" /><input type="search" aria-label="Buscar en inventario" placeholder="Buscar por nombre o código" autocomplete="off" @bind="busqueda" @bind:event="oninput" @bind:after="ReiniciarLista" /></div>
            <select aria-label="Categoría del inventario" @bind="categoria" @bind:after="ReiniciarLista"><option value="0">Todas las categorías</option>@foreach (var c in Categorias) { <option value="@c.Id">@c.Nombre</option> }</select>
            @if (busqueda.Length > 0 || categoria != 0) { <button type="button" class="inventory-clear" @onclick="LimpiarBusqueda">Limpiar filtros</button> }
        </div>
        <div class="inventory-filter-row" role="group" aria-label="Filtrar por existencias">
            @foreach (var filtro in filtros)
            { <button type="button" class="@(estadoActual == filtro.Valor ? "is-active" : "")" aria-pressed="@(estadoActual == filtro.Valor ? "true" : "false")" @onclick="() => CambiarEstado(filtro.Valor)">@filtro.Nombre</button> }
            <span role="status">@filtrados.Count @(filtrados.Count == 1 ? "producto" : "productos")</span>
        </div>
        @if (cargando) { <div class="inventory-empty" role="status">Cargando existencias…</div> }
        else if (filtrados.Count == 0) { <div class="inventory-empty"><Icono Nombre="caja" /><strong>No hay productos para esta consulta</strong><p>@(productos.Count == 0 ? "Los productos que registres aparecerán aquí." : "Prueba otro nombre, código, categoría o estado de existencias.")</p></div> }
        else
        {
            <div class="inventory-table-scroll" tabindex="0" aria-label="Tabla de existencias, desplázate para ver todas las columnas">
                <table class="inventory-table"><thead><tr><th>Producto</th><th>Categoría</th><th class="is-number">Existencias</th><th class="is-number">Mínimo</th><th class="is-number">Precio de venta</th><th>Estado</th></tr></thead>
                    <tbody>@foreach (var p in filtrados.Take(visibles))
                    { <tr><td><strong>@p.Nombre</strong><small>@p.Codigo</small></td><td>@p.CategoriaNombre</td><td class="is-number inventory-stock">@Cantidad(p.Stock, p) <small>@Unidad(p)</small></td><td class="is-number">@Cantidad(p.StockMinimo, p) <small>@Unidad(p)</small></td><td class="is-number">$@p.PrecioVenta.ToString("N2")</td><td><span class="inventory-status @(p.Stock <= 0 ? "is-empty" : p.Stock <= p.StockMinimo ? "is-low" : "is-normal")">@(p.Stock <= 0 ? "Sin stock" : p.Stock <= p.StockMinimo ? "Stock bajo" : "Disponible")</span></td></tr> }
                    </tbody>
                </table>
            </div>
            <div class="inventory-table-footer"><span>Mostrando @Math.Min(visibles, filtrados.Count) de @filtrados.Count productos</span>@if (visibles < filtrados.Count) { <button type="button" class="inventory-clear" @onclick="MostrarMas">Mostrar más productos</button> }</div>
        }
    </section>
</section>
