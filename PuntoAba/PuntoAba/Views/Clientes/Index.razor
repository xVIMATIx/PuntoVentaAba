@page "/clientes"
@inject IClienteService ClienteService
@inject SesionUsuarioService Sesion
<PageTitle>Clientes - PuntoAba</PageTitle>
<div class="page-header"><div><h2 class="page-title">Clientes</h2><p>Consulta tus clientes y mantén sus datos al día.</p></div><button type="button" class="btn btn-primary" disabled="@ocupado" @onclick="()=>MostrarModal(null)"><Icono Nombre="clientes" />Nuevo cliente</button></div>
@if(error!="") { <div class="alert alert-danger" role="alert">@error</div> }@if(exito!="") { <div class="alert alert-success" role="status">@exito</div> }
<div class="module-toolbar"><div><label for="customer-search">Buscar cliente</label><input id="customer-search" type="search" class="form-control" placeholder="Nombre, teléfono, correo o documento" @bind="filtro" @bind:event="oninput" @bind:after="Buscar" /></div><button type="button" class="btn btn-outline-secondary" disabled="@ocupado" @onclick="CargarClientes">Actualizar lista</button></div>
<div class="card"><div class="card-header"><span>Directorio de clientes</span><small>@clientesFiltrados.Count resultados · @clientes.Count clientes activos</small></div><div class="table-responsive"><table class="table"><thead><tr><th>Nombre</th><th>Teléfono</th><th>Correo</th><th>Documento</th><th>Acciones</th></tr></thead><tbody>
@foreach(var c in clientesFiltrados) { <tr><td><strong>@c.NombreCompleto</strong><small>@c.Direccion</small></td><td>@(c.Telefono??"—")</td><td>@(c.Email??"—")</td><td>@(c.DocumentoIdentidad??"—")</td><td><div class="btn-group"><button type="button" class="btn btn-outline-primary" disabled="@ocupado" aria-label="@($"Editar cliente {c.NombreCompleto}")" @onclick="()=>MostrarModal(c)">Editar</button>@if(Sesion.UsuarioActual?.Rol=="Admin" && c.Id!=1) { <button type="button" class="btn btn-outline-danger" disabled="@ocupado" aria-label="@($"Desactivar cliente {c.NombreCompleto}")" @onclick="()=>{errorModal=string.Empty;clienteEliminar=c;}">Desactivar</button> }</div></td></tr> }
@if(clientesFiltrados.Count==0) { <tr><td colspan="5" class="module-empty">@(ocupado?"Cargando clientes…":"No hay clientes con esta búsqueda.")</td></tr> }
</tbody></table></div></div>
@if(mostrarModal) {
<div class="modal show d-block" role="dialog" aria-modal="true" aria-labelledby="customer-title" tabindex="-1" @onkeydown="Tecla"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form @onsubmit="Guardar" @onsubmit:preventDefault="true"><div class="modal-header"><h3 id="customer-title" class="modal-title">@(clienteEditar.Id>0?"Editar cliente":"Nuevo cliente")</h3><button type="button" class="btn-close" aria-label="Cerrar formulario de cliente" disabled="@ocupado" @onclick="CerrarModal"></button></div><div class="modal-body">
@if(errorModal!="") { <div class="alert alert-danger" role="alert">@errorModal</div> }
<fieldset class="inv-fieldset" disabled="@ocupado"><div class="inv-fields"><div><label for="customer-name">Nombre obligatorio</label><input id="customer-name" class="form-control" required maxlength="200" @bind="clienteEditar.Nombre" @bind:event="oninput" /></div><div><label for="customer-last">Apellido</label><input id="customer-last" class="form-control" maxlength="100" @bind="clienteEditar.Apellido" @bind:event="oninput" /></div><div><label for="customer-phone">Teléfono</label><input id="customer-phone" type="tel" class="form-control" maxlength="50" @bind="clienteEditar.Telefono" @bind:event="oninput" /></div><div><label for="customer-mail">Correo</label><input id="customer-mail" type="email" class="form-control" maxlength="100" @bind="clienteEditar.Email" @bind:event="oninput" /></div><div><label for="customer-id">Documento</label><input id="customer-id" class="form-control" maxlength="50" @bind="clienteEditar.DocumentoIdentidad" @bind:event="oninput" /></div></div><label for="customer-address">Dirección</label><textarea id="customer-address" class="form-control" maxlength="300" rows="2" @bind="clienteEditar.Direccion" @bind:event="oninput"></textarea></fieldset>
</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" disabled="@ocupado" @onclick="CerrarModal">Cancelar</button><button type="submit" class="btn btn-primary" disabled="@ocupado">@(ocupado?"Guardando…":"Guardar cliente")</button></div></form></div></div></div><div class="modal-backdrop show"></div>
}
@if(clienteEliminar!=null) { <div class="modal show d-block" role="dialog" aria-modal="true" aria-labelledby="customer-remove"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h3 class="modal-title" id="customer-remove">Desactivar cliente</h3></div><div class="modal-body"><p>@clienteEliminar.NombreCompleto dejará de aparecer en el directorio. Sus ventas anteriores se conservarán.</p>@if(errorModal!="") { <div class="alert alert-danger" role="alert">@errorModal</div> }</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" disabled="@ocupado" @onclick="()=>clienteEliminar=null">Cancelar</button><button type="button" class="btn btn-outline-danger" disabled="@ocupado" @onclick="Eliminar">Desactivar cliente</button></div></div></div></div><div class="modal-backdrop show"></div> }
@code {
    [SupplyParameterFromQuery(Name="buscar")] public string? BuscarInicial {get;set;}
    private string? ultimoBuscar;
    private List<ClienteDto> clientes=new(),clientesFiltrados=new();
    private ClienteDto clienteEditar=new(); private ClienteDto? clienteEliminar;
    private bool mostrarModal,ocupado;
    private string filtro="",error="",errorModal="",exito="";
    protected override async Task OnInitializedAsync()=>await CargarClientes();
    protected override void OnParametersSet(){if(ultimoBuscar!=BuscarInicial){ultimoBuscar=BuscarInicial;filtro=BuscarInicial??"";Buscar();}}
    private void Buscar()=>clientesFiltrados=clientes.Where(c=>string.IsNullOrWhiteSpace(filtro)||new[]{c.NombreCompleto,c.Telefono,c.Email,c.DocumentoIdentidad}.Any(t=>t?.Contains(filtro.Trim(),StringComparison.OrdinalIgnoreCase)==true)).OrderBy(c=>c.NombreCompleto,StringComparer.Create(System.Globalization.CultureInfo.GetCultureInfo("es-MX"),true)).ToList();
    private async Task CargarClientes(){if(ocupado)return;ocupado=true;error="";try{await Recargar();}catch{error="No se pudieron consultar los clientes. Inténtalo de nuevo.";}finally{ocupado=false;}}
    private async Task Recargar(){clientes=await ClienteService.ObtenerTodosAsync();Buscar();}
    private void MostrarModal(ClienteDto? c){if(ocupado)return;errorModal="";exito="";clienteEditar=c==null?new():new(){Id=c.Id,Nombre=c.Nombre,Apellido=c.Apellido,Telefono=c.Telefono,Email=c.Email,Direccion=c.Direccion,DocumentoIdentidad=c.DocumentoIdentidad,Activo=c.Activo};mostrarModal=true;}
    private void CerrarModal(){if(!ocupado)mostrarModal=false;}
    private void Tecla(KeyboardEventArgs e){if(e.Key=="Escape")CerrarModal();}
    private async Task Guardar(){if(ocupado)return;ocupado=true;errorModal="";try{if(string.IsNullOrWhiteSpace(clienteEditar.Nombre))throw new ArgumentException("Escribe el nombre del cliente.");if(clienteEditar.Id==0)await ClienteService.CrearAsync(new(){Nombre=clienteEditar.Nombre,Apellido=clienteEditar.Apellido,Telefono=clienteEditar.Telefono,Email=clienteEditar.Email,Direccion=clienteEditar.Direccion,DocumentoIdentidad=clienteEditar.DocumentoIdentidad});else if(await ClienteService.ActualizarAsync(clienteEditar.Id,new(){Nombre=clienteEditar.Nombre,Apellido=clienteEditar.Apellido??"",Telefono=clienteEditar.Telefono??"",Email=clienteEditar.Email??"",Direccion=clienteEditar.Direccion??"",DocumentoIdentidad=clienteEditar.DocumentoIdentidad??""})==null)throw new ArgumentException("El cliente ya no existe.");mostrarModal=false;exito="Cliente guardado.";try{await Recargar();}catch{exito+=" Actualiza la lista para consultar los cambios.";}}catch(Exception ex){errorModal=ex is ArgumentException or System.ComponentModel.DataAnnotations.ValidationException or UnauthorizedAccessException?ex.Message:"No se pudo guardar el cliente. Tu captura se conserva.";}finally{ocupado=false;}}
    private async Task Eliminar(){if(ocupado||clienteEliminar==null)return;ocupado=true;errorModal="";try{await ClienteService.EliminarAsync(clienteEliminar.Id);clienteEliminar=null;exito="Cliente desactivado. Sus ventas se conservan.";try{await Recargar();}catch{exito+=" Actualiza la lista.";}}catch{errorModal="No se pudo desactivar el cliente.";}finally{ocupado=false;}}
}
