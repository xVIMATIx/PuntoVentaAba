{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "PuntoAba",
    "Audience": "PuntoAbaClients",
    "ExpiryInDays": 7
  },
  "AppSettings": {
    "NombreEmpresa": "Tienda de Abarrotes",
    "RfcEmpresa": "XAXX010101000",
    "DireccionEmpresa": "Calle Principal #123",
    "TelefonoEmpresa": "555-555-5555",
