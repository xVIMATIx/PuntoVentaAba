@code {
    private List<ProductoDto> productos = new();
    private List<ProductoDto> productosFiltrados = new();
    private List<ItemCarrito> carrito = new();
    private List<ClienteDto> clientes = new();
    
    private string filtro = "";
    private bool cargando = true;
    private bool procesando = false;
    
    // Paginación
    private int paginaActual = 0;
    private int productosPorPagina = 12;
    private int totalPaginas = 1;
    
    // Datos de venta
    private decimal descuento = 0;
    private string metodoPago = "Efectivo";
    private int clienteSeleccionado = 1;
    private string notas = "";
    private bool aplicarImpuesto = false;
    private decimal porcentajeImpuesto = 0m;
    
    // Modales
    private bool mostrarModalPago = false;
    private bool mostrarModalClientes = false;
    private bool mostrarModalPeso = false;
    private string modoCapturaPeso = "manual";
    private ProductoDto? productoPesoSeleccionado;
    private string pesoCaptura = "1.000";
    private string buscarCliente = "";
    private List<ClienteDto> clientesFiltradosBusqueda => clientes
        .Where(c =>
            string.IsNullOrWhiteSpace(buscarCliente) ||
            c.NombreCompleto.Contains(buscarCliente, StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrWhiteSpace(c.DocumentoIdentidad) && c.DocumentoIdentidad.Contains(buscarCliente, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    protected override void OnInitialized()
    {
        BalanzaService.EstadoChanged += ManejarCambioBalanza;
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private void ManejarCambioBalanza()
    {
        if (mostrarModalPeso && productoPesoSeleccionado != null && modoCapturaPeso == "balanza" && BalanzaService.PesoActual.HasValue)
        {
            pesoCaptura = BalanzaService.PesoActual.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private async Task CargarDatos()
    {
        cargando = true;
        try
        {
            productos = (await ProductoService.ObtenerTodosAsync()).ToList();
            productosFiltrados = productos;
            CalcularPaginacion();

            await CargarClientesAsync();
        }
        finally
        {
            cargando = false;
        }
    }

    private async Task CargarClientesAsync()
    {
        try
        {
            clientes = await HttpClient.GetFromJsonAsync<List<ClienteDto>>("api/clientes") ?? new();
        }
        catch (HttpRequestException ex)
        {
            await JS.InvokeVoidAsync("alert", $"No se pudo cargar la lista de clientes: {ex.Message}");
            clientes = new List<ClienteDto>();
        }

        if (clientes.All(c => c.Id != 1))
        {
            clientes.Insert(0, new ClienteDto { Id = 1, Nombre = "Cliente", Apellido = "General", DocumentoIdentidad = "000" });
        }
    }

    private async Task AbrirModalClientes()
    {
        await CargarClientesAsync();
        buscarCliente = "";
        mostrarModalClientes = true;
    }

    private void Filtrar()
    {
        if (string.IsNullOrWhiteSpace(filtro))
        {
            productosFiltrados = productos;
        }
        else
        {
            productosFiltrados = productos.Where(p =>
                p.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                p.Codigo.Contains(filtro, StringComparison.OrdinalIgnoreCase) ||
                (p.Descripcion != null && p.Descripcion.Contains(filtro, StringComparison.OrdinalIgnoreCase))
            ).ToList();
        }
        paginaActual = 0;
        CalcularPaginacion();
    }

    private void CalcularPaginacion()
    {
        totalPaginas = (int)Math.Ceiling((double)productosFiltrados.Count / productosPorPagina);
    }

    private void CambiarPagina(int pagina)
    {
        if (pagina >= 0 && pagina < totalPaginas)
        {
            paginaActual = pagina;
        }
    }

    private void AgregarAlCarrito(ProductoDto producto)
    {
        if (producto.Stock <= 0)
        {
            return;
        }

        if (producto.EsPorPeso)
        {
            productoPesoSeleccionado = producto;
            pesoCaptura = BalanzaService.PesoActual.HasValue
                ? BalanzaService.PesoActual.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)
                : "1.000";
            modoCapturaPeso = BalanzaService.Conectada ? "balanza" : "manual";
            mostrarModalPeso = true;
            return;
        }

        var item = carrito.FirstOrDefault(x => x.Producto.Id == producto.Id);
        if (item != null)
        {
            if (item.Cantidad < producto.Stock)
            {
                item.Cantidad += 1m;
            }
        }
        else
        {
            carrito.Add(new ItemCarrito { Producto = producto, Cantidad = 1m });
        }
    }

    private void AumentarCantidad(ItemCarrito item)
    {
        var incremento = item.Producto.EsPorPeso ? 0.1m : 1m;

        if (item.Cantidad + incremento <= item.Producto.Stock)
        {
            item.Cantidad += incremento;
        }
    }

    private void DisminuirCantidad(ItemCarrito item)
    {
        var decremento = item.Producto.EsPorPeso ? 0.1m : 1m;

        if (item.Cantidad > decremento)
        {
            item.Cantidad -= decremento;
        }
    }

    private async Task ConfirmarPeso()
    {
        if (productoPesoSeleccionado == null)
        {
            return;
        }

        if (!decimal.TryParse(pesoCaptura, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.CurrentCulture, out var peso)
            && !decimal.TryParse(pesoCaptura, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out peso))
        {
            await JS.InvokeVoidAsync("alert", "Ingrese un peso válido");
            return;
        }

        if (peso <= 0)
        {
            await JS.InvokeVoidAsync("alert", "El peso debe ser mayor a cero");
            return;
        }

        if (peso > productoPesoSeleccionado.Stock)
        {
            await JS.InvokeVoidAsync("alert", "Peso insuficiente en inventario");
            return;
        }

        var item = carrito.FirstOrDefault(x => x.Producto.Id == productoPesoSeleccionado.Id);
        if (item != null)
        {
            item.Cantidad += peso;
        }
        else
        {
            carrito.Add(new ItemCarrito { Producto = productoPesoSeleccionado, Cantidad = peso });
        }

        CerrarModalPeso();
        ActualizarCarrito();
        await Task.CompletedTask;
    }

    private void CerrarModalPeso()
    {
        mostrarModalPeso = false;
        productoPesoSeleccionado = null;
        pesoCaptura = "1.000";
        modoCapturaPeso = "manual";
    }

    private void CambiarModoCapturaPeso(string modo)
    {
        modoCapturaPeso = modo;
        if (modo == "balanza" && BalanzaService.PesoActual.HasValue)
        {
            pesoCaptura = BalanzaService.PesoActual.Value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private decimal CalcularSubtotalPeso()
    {
        if (productoPesoSeleccionado == null)
        {
            return 0;
        }

        if (!decimal.TryParse(pesoCaptura, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.CurrentCulture, out var peso)
            && !decimal.TryParse(pesoCaptura, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out peso))
        {
            return 0;
        }

        return productoPesoSeleccionado.PrecioVenta * peso;
    }

    private void EliminarDelCarrito(ItemCarrito item)
    {
        carrito.Remove(item);
    }

    private void LimpiarCarrito()
    {
        carrito.Clear();
    }

    private void ActualizarCarrito()
    {
        StateHasChanged();
    }

    private void ActualizarDescuento(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out var valor))
        {
            descuento = valor;
            ActualizarCarrito();
        }
    }

    private void CambiarImpuesto()
    {
        ActualizarCarrito();
    }

    private decimal subtotal => carrito.Sum(x => x.Producto.PrecioVenta * x.Cantidad);
    private decimal iva => aplicarImpuesto ? (subtotal - descuento) * (porcentajeImpuesto / 100m) : 0;
    private decimal total => subtotal - descuento + iva;

    private async Task ProcesarVenta()
    {
        if (carrito.Count == 0)
        {
            await JS.InvokeVoidAsync("alert", "Agregue productos al carrito");
            return;
        }

        procesando = true;
        try
        {
            var ventaDto = new CrearVentaDto
            {
                ClienteId = clienteSeleccionado,
                UsuarioId = 1,
                MetodoPago = metodoPago,
                Descuento = descuento,
                Impuesto = iva,
                Notas = notas,
                Detalles = carrito.Select(x => new CrearDetalleVentaDto
                {
                    ProductoId = x.Producto.Id,
                    Cantidad = x.Cantidad,
                    PrecioUnitario = x.Producto.PrecioVenta,
                    Descuento = 0
                }).ToList()
            };

            await VentaService.CrearAsync(ventaDto);
            await JS.InvokeVoidAsync("alert", $"✅ Venta procesada exitosamente.\nTotal: ${total:N0}");
            
            carrito.Clear();
            descuento = 0;
            notas = "";
            aplicarImpuesto = false;
            porcentajeImpuesto = 0m;
            
            Navigation.NavigateTo("/ventas");
        }
        catch (HttpRequestException ex)
        {
            await JS.InvokeVoidAsync("alert", $"❌ Error de conexión: {ex.Message}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error en ProcesarVenta: {ex}");
            await JS.InvokeVoidAsync("alert", $"❌ Error al guardar: {ex.InnerException?.Message ?? ex.Message}");
        }
        finally
        {
            procesando = false;
        }
    }

    public class ItemCarrito
    {
        public ProductoDto Producto { get; set; } = null!;
        public decimal Cantidad { get; set; }
    }

    private static string ObtenerIconoMetodoPago(string metodoPago) => metodoPago switch
    {
        "Efectivo" => "💵",
        "Tarjeta" => "💳",
        "Cheque" => "🧾",
        "Transferencia" => "🏦",
        "Crédito" => "⏳",
        _ => "💰"
    };

    public class ClienteDto
    {
        public int Id { get; set; }
        public string Nombre { get; set; } = "";
        public string? Apellido { get; set; }
        public string NombreCompleto => $"{Nombre} {Apellido}".Trim();
        public string? DocumentoIdentidad { get; set; }
    }

    public void Dispose()
    {
        BalanzaService.EstadoChanged -= ManejarCambioBalanza;
    }
}
